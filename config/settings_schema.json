[
  {
    "name": "theme_info",
    "theme_name": "GENE Streetwear",
    "theme_version": "1.1.0",
    "theme_author": "GENE",
    "theme_documentation_url": "https://genestreetwear.com",
    "theme_support_url": "https://genestreetwear.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink / primary",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons, badges)",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Page background",
        "default": "#FAFAFA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card surface",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders / lines",
        "default": "#DDDDDD"
      },
      {
        "type": "color",
        "id": "color_tag",
        "label": "Tag / placeholder bg",
        "default": "#EFEFEF"
      },
      {
        "type": "color",
        "id": "color_text_2",
        "label": "Secondary text",
        "default": "#555555"
      },
      {
        "type": "color",
        "id": "color_text_3",
        "label": "Muted text",
        "default": "#999999"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n8"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading letter-spacing",
        "min": -5,
        "max": 2,
        "step": 1,
        "unit": "%",
        "default": -2
      }
    ]
  },
  {
    "name": "Buttons & shape",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button radius",
        "min": 0,
        "max": 999,
        "step": 1,
        "unit": "px",
        "default": 999
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 6
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Max content width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "checkbox",
        "id": "grayscale_editorial",
        "label": "Black & white hero / reviews / banner",
        "default": true
      }
    ]
  },
  {
    "name": "Store",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": 75
      }
    ]
  }
]