<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root { --ink:#1A1A1A; --ink-soft:#555; --ink-muted:#999; --paper:#E3E2DE; --line:#D2D1CC; --tag:#EFEFEF; --mono:'JetBrains Mono',ui-monospace,Menlo,monospace; --ease:cubic-bezier(.2,.8,.2,1); }
    * { box-sizing: border-box; }
    body { margin:0; font-family:'Inter',system-ui,sans-serif; background:var(--paper); color:var(--ink); -webkit-font-smoothing:antialiased; }
    a { color:var(--ink); }
    img { max-width:100%; }
    .g-wrap { max-width:1200px; margin:0 auto; padding:0 24px; }
    .g-eyebrow { font-family:var(--mono); font-size:11.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); }
    .g-h2 { font-weight:800; font-size:clamp(28px,3.4vw,38px); letter-spacing:-0.02em; margin:0; text-transform:uppercase; }
    .g-btn { display:inline-flex; align-items:center; justify-content:center; gap:9px; background:var(--ink); color:#fff; border:none; border-radius:999px; padding:14px 26px; font-weight:700; font-size:15px; cursor:pointer; text-decoration:none; font-family:inherit; transition:background .2s var(--ease), transform .08s; }
    .g-btn:hover { background:#000; }
    .g-btn:active { transform:scale(0.98); }
    .g-btn--outline { background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); }
    .g-btn--outline:hover { background:var(--ink); color:#fff; }
    main { min-height:50vh; }
    @media (max-width:640px) { .g-wrap { padding-left:16px; padding-right:16px; } }
    /* tighter vertical spacing between sections on phones */
    @media (max-width:749px) {
      .shopify-section > .g-wrap { padding-top:14px !important; padding-bottom:6px !important; }
      [id^="gene-grid-"] { padding-top:14px !important; padding-bottom:6px !important; }
    }
  </style>
</head>
<body>
  {%- comment -%}
    Hlavička se vkládá napřímo, ne přes sekční skupinu. JSON soubory skupin
    vlastní theme editor — když jednou z motivu vypadnou (což se stalo, viz
    commit s odstraněním "default" u url settingů), push z GitHubu je zpátky
    nevytvoří a volání skupiny nemá co vykreslit. Statické sekce na žádný
    další soubor nečekají.
  {%- endcomment -%}
  {% section 'gene-announcement' %}
  {% section 'gene-header' %}
  <main>{{ content_for_layout }}</main>

  <footer style="background:#1A1A1A;color:#fff;margin-top:40px;padding:56px 24px 28px;">
    {%- comment -%} newsletter — Shopify formulář zákazníka, odběratel dostane tag "newsletter" {%- endcomment -%}
    <div class="g-wrap gfoot-news">
      <div>
        <h4 class="gfoot-news-h">Get 10% off your first order</h4>
        <p class="gfoot-news-p">New drops, restocks and early access — straight to your inbox.</p>
      </div>
      {% form 'customer', class: 'gfoot-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Enter your email" aria-label="Email" autocomplete="email" required>
        <button type="submit">Get your discount</button>
        {%- if form.posted_successfully? -%}
          <p class="gfoot-note gfoot-note--ok">Thanks — check your inbox.</p>
        {%- elsif form.errors -%}
          <p class="gfoot-note gfoot-note--err">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {% endform %}
    </div>

    <div class="g-wrap gfoot-grid">
      <div>
        <img src="{{ 'gene-logo.png' | asset_url }}" alt="{{ shop.name }}" style="height:34px;width:auto;display:block;filter:invert(1) brightness(2);margin-bottom:14px;">
        <p style="font-size:13px;color:rgba(255,255,255,0.6);max-width:260px;line-height:1.55;margin:0;">Limited streetwear drops. Built different, worn loud. Thousands of customers worldwide.</p>
      </div>
      <div>
        <h4 class="gfoot-h">Policies</h4>
        <div class="gfoot-links">
          <a href="/pages/refund-policy">Refund Policy</a>
          <a href="/pages/terms-of-service">Terms of Service</a>
          <a href="/pages/shipping-policy">Shipping Policy</a>
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/contact">Contact Information</a>
        </div>
      </div>
      <div>
        <h4 class="gfoot-h">Contact Us:</h4>
        <div class="gfoot-links">
          <span style="color:rgba(255,255,255,0.65);">Email us at:</span>
          <a href="mailto:support@genestreetwear.com">support@genestreetwear.com</a>
        </div>
      </div>
      <div>
        <h4 class="gfoot-h">Our Links:</h4>
        <div class="gfoot-links">
          <a href="https://www.tiktok.com/@genestreetwear" target="_blank" rel="noopener">TikTok</a>
          <a href="https://www.instagram.com/genestreetwear" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
    </div>
    <div class="g-wrap" style="margin-top:36px;border-top:1px solid rgba(255,255,255,0.15);padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:rgba(255,255,255,0.5);">
      <span>© 2026 GENE STREETWEAR</span>
      <span style="font-family:'JetBrains Mono',monospace;">Visa · Mastercard · Amex · Apple Pay · Shop Pay · Klarna</span>
      <span style="font-family:'JetBrains Mono',monospace;">Designed by Digital School</span>
    </div>
  </footer>
  {% render 'gene-quick-add' %}

  <style>
    .gfoot-news { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px 40px; padding-bottom:34px; margin-bottom:34px; border-bottom:1px solid rgba(255,255,255,0.15); }
    .gfoot-news-h { font-weight:800; font-size:clamp(20px,2.2vw,26px); letter-spacing:-0.02em; text-transform:uppercase; margin:0 0 6px; }
    .gfoot-news-p { font-size:13.5px; color:rgba(255,255,255,0.6); margin:0; max-width:44ch; }
    .gfoot-form { display:flex; flex-wrap:wrap; gap:10px; flex:1 1 380px; max-width:520px; position:relative; }
    .gfoot-form input[type="email"] { flex:1 1 200px; min-width:0; height:52px; padding:0 18px; border:1px solid rgba(255,255,255,0.3); border-radius:999px; background:transparent; color:#fff; font:inherit; font-size:14px; }
    .gfoot-form input[type="email"]::placeholder { color:rgba(255,255,255,0.45); }
    .gfoot-form input[type="email"]:focus { outline:none; border-color:#fff; }
    .gfoot-form button { height:52px; padding:0 26px; border:none; border-radius:999px; background:#fff; color:var(--ink); font:inherit; font-size:14px; font-weight:700; cursor:pointer; white-space:nowrap; transition:opacity .15s var(--ease); }
    .gfoot-form button:hover { opacity:.88; }
    .gfoot-note { flex-basis:100%; margin:0; font-size:13px; }
    .gfoot-note--ok { color:#8fd6a6; }
    .gfoot-note--err { color:#ff9b8f; }
    @media (max-width:700px){
      .gfoot-news { flex-direction:column; align-items:stretch; }
      .gfoot-form { max-width:none; }
      .gfoot-form button { width:100%; }
    }
    .gfoot-grid { display:flex; flex-wrap:wrap; gap:36px 56px; align-items:flex-start; }
    .gfoot-grid > div:first-child { flex:1 1 240px; min-width:220px; max-width:320px; }
    .gfoot-grid > div { flex:0 0 auto; }
    .gfoot-h { font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.5); margin:0 0 14px; }
    .gfoot-links { display:flex; flex-direction:column; gap:9px; font-size:13.5px; }
    .gfoot-links a { color:rgba(255,255,255,0.85); text-decoration:none; }
    .gfoot-links a:hover { color:#fff; text-decoration:underline; }
    @media (max-width:900px){ .gfoot-grid{ gap:28px 40px; } .gfoot-grid > div:first-child{ flex-basis:100%; max-width:none; } }
  </style>
</body>
</html>