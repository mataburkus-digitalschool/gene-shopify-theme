{%- liquid
  assign p = card_product
  assign on_sale = false
  if p.compare_at_price > p.price
    assign on_sale = true
  endif
  assign img2 = p.media[1]
-%}
<div class="gene-prod{% unless p.available %} is-out{% endunless %}" data-product-card {% if p.selected_or_first_available_variant %}data-variant="{{ p.selected_or_first_available_variant.id }}"{% endif %}>
  <a href="{{ p.url }}" class="gene-prod__media">
    {%- if p.featured_media -%}
      <img src="{{ p.featured_media | image_url: width: 700 }}" alt="{{ p.title | escape }}" loading="lazy" width="700" height="875">
    {%- endif -%}
    {%- if img2 -%}
      <img class="two" src="{{ img2 | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="875">
    {%- endif -%}
    {%- if p.available and on_sale -%}
      {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
      <span class="gene-badge">&minus;{{ pct }}%</span>
    {%- elsif p.available and card_new -%}
      <span class="gene-badge">NEW</span>
    {%- endif -%}
    {%- unless p.available -%}<span class="gene-badge gene-badge--out">SOLD OUT</span>{%- endunless -%}
    {%- if p.available and p.metafields.custom.low_stock -%}
      <span class="gene-low">{{ p.metafields.custom.low_stock }}</span>
    {%- endif -%}
  </a>
  <div class="gene-prod__body">
    <a href="{{ p.url }}" class="gene-prod__title">{{ p.title }}</a>
    <div class="gene-price">
      <b>{{ p.price | money }}</b>
      {%- if on_sale -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
    </div>
    {%- if p.available -%}
      {%- assign size_opt = null -%}
      {%- for opt in p.options_with_values -%}
        {%- assign dn = opt.name | downcase -%}
        {%- if dn contains 'size' or dn contains 'velikost' -%}{%- assign size_opt = opt -%}{%- endif -%}
      {%- endfor -%}
      {%- if size_opt -%}
        <div class="gene-sizes">
          {%- for v in size_opt.values -%}
            {%- assign vpos = size_opt.position -%}
            {%- assign match_variant = null -%}
            {%- for variant in p.variants -%}
              {%- assign ov = variant.options[forloop.index0] -%}
              {%- if vpos == 1 and variant.option1 == v %}{% assign match_variant = variant %}{% endif -%}
              {%- if vpos == 2 and variant.option2 == v %}{% assign match_variant = variant %}{% endif -%}
              {%- if vpos == 3 and variant.option3 == v %}{% assign match_variant = variant %}{% endif -%}
            {%- endfor -%}
            <button class="gene-size{% if forloop.first %} is-active{% endif %}" data-variant="{{ match_variant.id }}"{% unless match_variant.available %} disabled{% endunless %}>{{ v }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <button class="gene-add" data-add {% unless size_opt %}data-variant="{{ p.selected_or_first_available_variant.id }}"{% endunless %}>Quick add &mdash; {{ p.price | money }}</button>
    {%- else -%}
      <button class="gene-notify" data-notify="{{ p.id }}">Notify me when in stock</button>
    {%- endif -%}
  </div>
</div>