{%- comment -%}
  Jeden sdílený panel rychlého přidání pro celý motiv. Vykresluje se jednou
  z layoutu; sekce s produkty jen dávají na kartu data-product, na ikonu
  data-qa-open a dovnitř JSON .gg-qa s variantami. Dřív měla každá mřížka
  vlastní kopii modalu i obsluhy a všechny tři se rozjížděly.
{%- endcomment -%}
<div class="gqa" id="gene-quick-add" hidden>
  <div class="gqa__overlay" data-qa-close></div>
  <div class="gqa__panel" role="dialog" aria-modal="true" aria-label="Rychlé přidání do košíku">
    <button class="gqa__close" type="button" data-qa-close aria-label="Zavřít">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="gqa__prod">
      <div class="gqa__img"><img data-qa-img src="" alt="" loading="lazy"></div>
      <div class="gqa__meta">
        <div class="gqa__name" data-qa-name></div>
        <div class="gqa__price" data-qa-price></div>
      </div>
    </div>

    <div class="gqa__options" data-qa-options></div>

    <div class="gqa__buy">
      <div class="gqa__qty">
        <button type="button" data-qa-qty="-" aria-label="Méně">−</button>
        <input type="number" value="1" min="1" inputmode="numeric" data-qa-qty-input aria-label="Množství">
        <button type="button" data-qa-qty="+" aria-label="Více">+</button>
      </div>
      <button type="button" class="gqa__atc" data-qa-add>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 8.5h11v10a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5v-10Z"/><path d="M7.5 8.5V6.5a2.5 2.5 0 0 1 5 0v2"/><path d="M19 3.5v5M16.5 6h5"/></svg>
        <span data-qa-add-label>Add to cart</span>
      </button>
    </div>

    <a class="gqa__more" data-qa-link href="#">View full details</a>
  </div>
</div>

<style>
  .gqa{ position:fixed; inset:0; z-index:300; display:flex; align-items:center; justify-content:center; }
  .gqa[hidden]{ display:none; }
  .gqa__overlay{ position:absolute; inset:0; background:rgba(0,0,0,.5); }
  .gqa__panel{
    position:relative; z-index:1; width:520px; max-width:calc(100% - 32px); max-height:88vh;
    overflow-y:auto; background:var(--paper); border-radius:16px; padding:22px;
    box-shadow:0 20px 60px rgba(0,0,0,.28);
  }
  .gqa__close{
    position:absolute; top:14px; right:14px; width:38px; height:38px; padding:0;
    display:inline-flex; align-items:center; justify-content:center;
    background:var(--paper); color:var(--ink); border:1px solid var(--line);
    border-radius:10px; cursor:pointer;
  }
  .gqa__close svg{ width:20px; height:20px; }

  .gqa__prod{ display:flex; gap:14px; align-items:center; padding-right:52px; }
  .gqa__img{ width:84px; height:84px; flex:none; border-radius:8px; overflow:hidden; background:var(--tag); }
  .gqa__img img{ width:100%; height:100%; object-fit:cover; display:block; }
  .gqa__name{ font-weight:700; font-size:16px; line-height:1.25; }
  .gqa__price{ font-weight:700; font-size:15px; margin-top:4px; }
  .gqa__price s{ color:var(--ink-muted); font-weight:400; margin-right:6px; }

  .gqa__group{ margin-top:20px; }
  .gqa__label{ font-size:14px; font-weight:600; margin:0 0 10px; }
  .gqa__label span{ font-weight:400; color:var(--ink-soft); }
  .gqa__vals{ display:flex; flex-wrap:wrap; gap:9px; }
  .gqa__val{
    min-width:56px; padding:12px 16px; border:1.5px solid var(--line); border-radius:10px;
    background:var(--paper); color:var(--ink); font:inherit; font-size:14px; font-weight:600;
    cursor:pointer; transition:border-color .15s var(--ease), background .15s var(--ease);
  }
  .gqa__val:hover:not(:disabled){ border-color:var(--ink); }
  .gqa__val.on{ background:var(--ink); color:#fff; border-color:var(--ink); }
  .gqa__val:disabled{ color:var(--ink-muted); border-style:dashed; cursor:default; text-decoration:line-through; }

  .gqa__buy{ display:flex; align-items:stretch; gap:10px; margin-top:20px; }
  .gqa__qty{ display:inline-flex; align-items:center; flex:none; border:1.5px solid var(--line); border-radius:10px; overflow:hidden; }
  .gqa__qty button{ width:40px; height:52px; border:none; background:var(--paper); color:var(--ink); font-size:19px; cursor:pointer; }
  .gqa__qty input{ width:44px; height:52px; border:none; text-align:center; font:inherit; font-size:15px; background:var(--paper); color:var(--ink); -moz-appearance:textfield; }
  .gqa__qty input::-webkit-outer-spin-button,.gqa__qty input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
  .gqa__atc{
    flex:1; min-width:0; display:inline-flex; align-items:center; justify-content:center; gap:10px;
    background:var(--ink); color:#fff; border:none; border-radius:10px; padding:0 20px; height:52px;
    font:inherit; font-size:15px; font-weight:700; cursor:pointer; transition:opacity .15s var(--ease);
  }
  .gqa__atc svg{ width:19px; height:19px; flex:none; }
  .gqa__atc:hover{ opacity:.9; }
  .gqa__atc:disabled{ opacity:.45; cursor:default; }

  .gqa__more{ display:block; text-align:center; margin-top:16px; font-size:13.5px; color:var(--ink-soft); }

  @media (max-width:600px){
    .gqa{ align-items:flex-end; }
    .gqa__panel{ width:100%; max-width:100%; border-radius:18px 18px 0 0; padding:18px 16px calc(18px + env(safe-area-inset-bottom)); }
    .gqa__val{ min-width:50px; padding:11px 13px; }
  }
</style>

<script>
(function () {
  var modal = document.getElementById('gene-quick-add');
  if (!modal || modal.dataset.init) return;
  modal.dataset.init = '1';

  var optsWrap = modal.querySelector('[data-qa-options]');
  var qtyInput = modal.querySelector('[data-qa-qty-input]');
  var addBtn   = modal.querySelector('[data-qa-add]');
  var addLabel = modal.querySelector('[data-qa-add-label]');
  var link     = modal.querySelector('[data-qa-link]');
  var data     = null;   // aktuální produkt
  var picked   = [];     // vybraná hodnota pro každou volbu

  function refreshCart() {
    fetch('{{ routes.cart_url }}.js').then(function (r) { return r.json(); }).then(function (cart) {
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = cart.item_count;
        el.classList.toggle('is-empty', cart.item_count === 0);
      });
    }).catch(function () {});
  }

  function matchingVariant() {
    return (data.variants || []).find(function (v) {
      return v.opts.every(function (val, i) { return val === picked[i]; });
    });
  }

  // Dostupnost se posuzuje jen podle voleb PŘED touhle. Kdyby se přihlíželo
  // i k těm následujícím, zašedla by barva jen proto, že v ní není zrovna
  // vybraná velikost — a nešla by kliknout.
  function valueAvailable(index, value) {
    return (data.variants || []).some(function (v) {
      if (!v.available || v.opts[index] !== value) return false;
      for (var j = 0; j < index; j++) { if (v.opts[j] !== picked[j]) return false; }
      return true;
    });
  }

  // Po změně volby doladíme následující, aby výběr seděl na existující variantě
  function repairFrom(index) {
    for (var i = index + 1; i < (data.options || []).length; i++) {
      if (!valueAvailable(i, picked[i])) {
        var fix = data.options[i].values.filter(function (val) { return valueAvailable(i, val); })[0];
        if (fix) picked[i] = fix;
      }
    }
  }

  function renderOptions() {
    optsWrap.innerHTML = (data.options || []).map(function (opt, i) {
      var vals = opt.values.map(function (val) {
        var off = valueAvailable(i, val) ? '' : ' disabled';
        var on  = picked[i] === val ? ' on' : '';
        return '<button type="button" class="gqa__val' + on + '" data-opt="' + i + '" data-val="' + val.replace(/"/g, '&quot;') + '"' + off + '>' + val + '</button>';
      }).join('');
      return '<div class="gqa__group"><div class="gqa__label">' + opt.name +
             ' <span>' + (picked[i] || '') + '</span></div><div class="gqa__vals">' + vals + '</div></div>';
    }).join('');

    var v = matchingVariant();
    addBtn.disabled = !v || !v.available;
    addLabel.textContent = v && v.available ? 'Add to cart' : (v ? 'Sold out' : 'Select options');
  }

  function open(card) {
    var dataEl = card && card.querySelector('script.gg-qa');
    if (!dataEl) return;
    try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

    var img = modal.querySelector('[data-qa-img]');
    if (img) { if (data.img) { img.src = data.img; img.style.display = ''; } else { img.style.display = 'none'; } }
    modal.querySelector('[data-qa-name]').textContent = data.name || '';
    modal.querySelector('[data-qa-price]').innerHTML =
      (data.compare ? '<s>' + data.compare + '</s>' : '') + (data.price || '');
    if (link) { link.href = data.url || '#'; link.hidden = !data.url; }

    // první skladová varianta jako výchozí výběr
    var first = (data.variants || []).find(function (v) { return v.available; }) || data.variants[0];
    picked = first ? first.opts.slice() : [];

    optsWrap.hidden = !!data.singleVariant;
    if (data.singleVariant) {
      optsWrap.innerHTML = '';
      addBtn.disabled = !(first && first.available);
      addLabel.textContent = addBtn.disabled ? 'Sold out' : 'Add to cart';
    } else {
      renderOptions();
    }

    qtyInput.value = 1;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() { modal.hidden = true; document.body.style.overflow = ''; data = null; }

  document.addEventListener('click', function (e) {
    var openBtn = e.target.closest('[data-qa-open]');
    if (openBtn) { e.preventDefault(); open(openBtn.closest('[data-product]')); }
  });

  modal.addEventListener('click', function (e) {
    if (e.target.closest('[data-qa-close]')) { close(); return; }

    var val = e.target.closest('.gqa__val');
    if (val && !val.disabled) {
      var idx = Number(val.dataset.opt);
      picked[idx] = val.dataset.val;
      repairFrom(idx);
      renderOptions();
      return;
    }

    var step = e.target.closest('[data-qa-qty]');
    if (step) {
      var n = parseInt(qtyInput.value, 10) || 1;
      n += step.getAttribute('data-qa-qty') === '+' ? 1 : -1;
      qtyInput.value = n < 1 ? 1 : n;
      return;
    }

    if (e.target.closest('[data-qa-add]') && !addBtn.disabled && data) {
      var v = data.singleVariant ? data.variants[0] : matchingVariant();
      if (!v) return;
      addBtn.disabled = true;
      addLabel.textContent = '…';
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(v.id), quantity: parseInt(qtyInput.value, 10) || 1 })
      }).then(function (r) {
        if (!r.ok) throw new Error('add');
        addLabel.textContent = '\u2713 Added';
        refreshCart();
        setTimeout(close, 700);
      }).catch(function () {
        addBtn.disabled = false;
        addLabel.textContent = 'Add to cart';
      });
    }
  });

  document.addEventListener('keydown', function (e) { if (!modal.hidden && e.key === 'Escape') close(); });
})();
</script>
