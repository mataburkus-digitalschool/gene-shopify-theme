<div class="gene-overlay" data-cart-close></div>
<aside class="gene-drawer" aria-label="Cart">
  <div class="gene-drawer__head">
    <b>Your cart (<span data-cart-count>{{ cart.item_count }}</span>)</b>
    <button class="gene-drawer__close" data-cart-close aria-label="Close">&times;</button>
  </div>
  <div class="gene-ship" id="geneShip">
    <div class="gene-ship__label" id="geneShipLabel"></div>
    <div class="gene-ship__bar"><div class="gene-ship__fill" id="geneShipFill"></div></div>
  </div>
  <div class="gene-drawer__items" id="geneDrawerItems"></div>
  <div class="gene-drawer__empty" id="geneDrawerEmpty" style="display:none">
    <div style="font-family:var(--font-display);font-weight:700;font-size:18px">Your cart is empty</div>
    <p style="font-size:13.5px;color:var(--fg-2);margin:0;max-width:220px">The drop won't wait. Add something before it sells out.</p>
    <button class="gene-btn gene-btn--ink" data-cart-close>Shop the drop</button>
  </div>
  <div class="gene-drawer__foot" id="geneDrawerFoot">
    <div class="gene-drawer__sub"><span style="font-size:14px;color:var(--fg-2)">Subtotal</span><b id="geneSubtotal">{{ cart.total_price | money }}</b></div>
    <button class="gene-checkout" onclick="window.location='{{ routes.cart_url }}?checkout'" formaction="{{ routes.cart_url }}">Checkout &rarr;</button>
    <button class="gene-btn gene-btn--out" style="width:100%;justify-content:center" data-cart-close>Continue shopping</button>
  </div>
</aside>
<script>window.geneFreeShip={{ settings.free_shipping_threshold | default: 75 }};</script>