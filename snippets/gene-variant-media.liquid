      when 'gene-vintage-denim-shorts'
        # foto 2 = White; foto 3 = Gray
        assign gvm_manual = 'use_the_provided_photo_of_the_models_and_replace_their_current_outfits_with_the_provided_t-shirt_an_umzkamdq0ptyhit180h9_1.png::White;;use_the_provided_photo_of_the_models_and_replace_their_current_outfits_with_the_provided_t-shirt_a_ukscoct13texjebm89yr_0.png::Gray'
      when 'gene-flame-jeans'
        # foto 2 = Black; foto 4 = Light blue
