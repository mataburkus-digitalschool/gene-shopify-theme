    endcase
    assign gvm_manual_entries = gvm_manual | split: ';;'
    assign gvm_color_values = product.options_with_values[gvm_color_index].values
    assign gvm_cur = product.selected_or_first_available_variant
    assign gvm_selected = gvm_cur.options[gvm_color_index] | downcase
    assign gvm_selected_needle = '||' | append: gvm_selected | append: '||'
    assign gvm_media_map = ''
    assign gvm_hidden_ids = ''

    for gvm_media in product.media
      assign gvm_media_id = gvm_media.id | append: ''
      assign gvm_colors = ''

      # 1. fotka prirazena k variante v adminu
      for gvm_variant in product.variants
        if gvm_variant.featured_media.id == gvm_media.id
          assign gvm_value = gvm_variant.options[gvm_color_index]
          assign gvm_needle = '||' | append: gvm_value | append: '||'
          assign gvm_probe = '||' | append: gvm_colors | append: '||'
          unless gvm_probe contains gvm_needle
            if gvm_colors == ''
              assign gvm_colors = gvm_value
            else
              assign gvm_colors = gvm_colors | append: '||' | append: gvm_value
            endif
          endunless
        endif
      endfor

      # 2. nazev barvy v alt textu fotky
      if gvm_colors == ''
        assign gvm_alt = gvm_media.alt | downcase
        if gvm_alt != blank
          for gvm_value in gvm_color_values
            assign gvm_value_down = gvm_value | downcase
            if gvm_alt contains gvm_value_down
              if gvm_colors == ''
                assign gvm_colors = gvm_value
              else
                assign gvm_colors = gvm_colors | append: '||' | append: gvm_value
              endif
            endif
          endfor
        endif
      endif

      # 3. rucni mapa podle nazvu souboru
      if gvm_colors == '' and gvm_manual != ''
        assign gvm_src = gvm_media.preview_image.src | split: '?' | first
        for gvm_entry in gvm_manual_entries
          assign gvm_parts = gvm_entry | split: '::'
          assign gvm_file = '/' | append: gvm_parts[0]
          if gvm_src contains gvm_file
            assign gvm_colors = gvm_parts[1]
            break
          endif
        endfor
      endif

      if gvm_colors != ''
        assign gvm_entry = gvm_media_id | append: '::' | append: gvm_colors
        if gvm_media_map == ''
          assign gvm_media_map = gvm_entry
        else
          assign gvm_media_map = gvm_media_map | append: ';;' | append: gvm_entry
        endif

        assign gvm_colors_down = '||' | append: gvm_colors | append: '||' | downcase
        unless gvm_colors_down contains gvm_selected_needle
          if gvm_hidden_ids == ''
            assign gvm_hidden_ids = gvm_media_id
          else
            assign gvm_hidden_ids = gvm_hidden_ids | append: ',' | append: gvm_media_id
          endif
        endunless
      endif
    endfor
  -%}

  {%- if gvm_media_map != '' -%}
    {%- assign gvm_map_entries = gvm_media_map | split: ';;' -%}
    <script type="application/json" data-gvm>
      {"colorIndex":{{ gvm_color_index }},"media":{
      {%- for gvm_entry in gvm_map_entries -%}
        {%- assign gvm_parts = gvm_entry | split: '::' -%}
        {%- unless forloop.first -%},{%- endunless -%}
        "{{ gvm_parts[0] }}":[
        {%- assign gvm_values = gvm_parts[1] | split: '||' -%}
        {%- for gvm_value in gvm_values -%}
          {%- unless forloop.first -%},{%- endunless -%}{{ gvm_value | json }}
        {%- endfor -%}
        ]
      {%- endfor -%}
      }}
    </script>
  {%- endif -%}

  {%- if gvm_hidden_ids != '' -%}
    {%- assign gvm_hidden_list = gvm_hidden_ids | split: ',' -%}
    <style data-gvm-style>
      {% for gvm_id in gvm_hidden_list -%}
        #gpm-{{ section_id }} [data-media-id="{{ gvm_id }}"]{% unless forloop.last %},{% endunless %}
      {%- endfor %} {
        display: none !important;
      }
    </style>
  {%- endif -%}
{%- endif -%}
