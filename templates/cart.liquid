<div class="g-wrap" style="padding:48px 24px;max-width:860px;">
  <h1 style="font-weight:800;">Košík</h1>
  {% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post">
    {% for item in cart.items %}
    <div style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);align-items:center;">
      {% if item.image %}<img src="{{ item.image | image_url: width: 120 }}" style="width:64px;height:80px;object-fit:cover;border-radius:4px;">{% endif %}
      <div style="flex:1;"><div style="font-weight:600;">{{ item.product.title }}</div><div style="font-size:12px;color:#777;">{{ item.variant.title }}</div></div>
      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;padding:8px;border:1px solid var(--line);border-radius:6px;">
      <div style="font-weight:700;min-width:80px;text-align:right;">{{ item.final_line_price | money }}</div>
    </div>
    {% endfor %}
    <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;">
      <button type="submit" class="g-btn g-btn--outline">Přepočítat</button>
      <div style="display:flex;align-items:center;gap:16px;"><b style="font-size:18px;">{{ cart.total_price | money }}</b><button type="submit" name="checkout" class="g-btn">Pokladna →</button></div>
    </div>
  </form>
  {% else %}<p>Košík je prázdný.</p><a class="g-btn" href="{{ routes.root_url }}">Zpět do obchodu</a>{% endif %}
</div>