{%- comment -%} Práh pro dopravu zdarma v haléřích (150000 = 1500 Kč). Uprav dle skutečné hranice. {%- endcomment -%}
{%- assign free_ship_threshold = 150000 -%}

<div class="g-wrap gcart" style="padding:48px 24px;max-width:920px;">
  <h1 style="font-weight:800;margin:0 0 22px;">Košík</h1>

  {% if cart.item_count > 0 %}

    {%- comment -%} ── FREE SHIPPING BAR ── {%- endcomment -%}
    {%- assign remaining = free_ship_threshold | minus: cart.total_price -%}
    {%- assign pct = cart.total_price | times: 100 | divided_by: free_ship_threshold -%}
    {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
    <div class="gcart-ship">
      <div class="gcart-ship-msg">
        {%- if remaining > 0 -%}
          🚚 Přidej ještě <b>{{ remaining | money }}</b> a máš <b>dopravu zdarma</b>!
        {%- else -%}
          🎉 <b>Máš dopravu zdarma!</b> Můžeš jít do pokladny.
        {%- endif -%}
      </div>
      <div class="gcart-ship-track"><div class="gcart-ship-fill" style="width:{{ pct }}%;"></div></div>
    </div>

    <form action="{{ routes.cart_url }}" method="post" class="gcart-form">
      {% for item in cart.items %}
      <div class="gcart-row">
        {% if item.image %}<a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.product.title | escape }}"></a>{% endif %}
        <div class="gcart-info">
          <a href="{{ item.url }}" class="gcart-name">{{ item.product.title }}</a>
          {%- unless item.variant.title contains 'Default' -%}<div class="gcart-var">{{ item.variant.title }}</div>{%- endunless -%}
          {%- if item.original_line_price > item.final_line_price -%}<div class="gcart-save">Ušetřeno {{ item.original_line_price | minus: item.final_line_price | money }}</div>{%- endif -%}
        </div>
        <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="gcart-qty" aria-label="Množství">
        <div class="gcart-price">{{ item.final_line_price | money }}</div>
        <a href="{{ item.url_to_remove }}" class="gcart-remove" aria-label="Odebrat">✕</a>
      </div>
      {% endfor %}

      <div class="gcart-foot">
        <button type="submit" class="g-btn g-btn--outline">Přepočítat</button>
        <div class="gcart-foot-r">
          <span class="gcart-total"><span style="font-weight:400;color:var(--ink-soft);font-size:14px;">Mezisoučet</span> <b>{{ cart.total_price | money }}</b></span>
          <button type="submit" name="checkout" class="g-btn">Pokladna →</button>
        </div>
      </div>
      <div class="gcart-note">Doprava a slevy se spočítají v pokladně.</div>
    </form>

    {%- comment -%} ── UPSELL ── {%- endcomment -%}
    {%- assign cart_ids = '' -%}
    {%- for item in cart.items -%}{%- assign cart_ids = cart_ids | append: item.product.id | append: ',' -%}{%- endfor -%}
    {%- assign pool = collections.all.products -%}
    {%- assign upsell_count = 0 -%}
    <div class="gcart-up">
      <h2 class="gcart-up-title">Mohlo by se ti líbit</h2>
      <div class="gcart-up-grid">
        {%- for p in pool -%}
          {%- assign pid = p.id | append: ',' -%}
          {%- unless cart_ids contains pid -%}
            {%- if p.available and upsell_count < 3 -%}
              {%- assign upsell_count = upsell_count | plus: 1 -%}
              <div class="gcart-up-card">
                <a href="{{ p.url }}" class="gcart-up-img">{% if p.featured_media %}<img src="{{ p.featured_media | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy">{% endif %}</a>
                <div class="gcart-up-body">
                  <a href="{{ p.url }}" class="gcart-up-name">{{ p.title }}</a>
                  <div class="gcart-up-price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {%- endif -%}{{ p.price | money }}</div>
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="g-btn g-btn--outline gcart-up-add">+ Přidat</button>
                  </form>
                </div>
              </div>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>

  {% else %}
    <p class="gcart-empty">Košík je zatím prázdný — mrkni na to, co teď letí. 👇</p>
    <a class="g-btn g-btn--outline" href="{{ routes.all_products_collection_url | default: routes.root_url }}" style="margin-bottom:38px;">Prohlédnout obchod</a>

    {%- assign bs = collections['best-sellers'].products | default: collections['frontpage'].products | default: collections.all.products -%}
    <div class="gcart-up" style="border-top:none;margin-top:0;padding-top:0;">
      <h2 class="gcart-up-title">Nejprodávanější</h2>
      <div class="gcart-up-grid gcart-up-grid--4">
        {%- assign n = 0 -%}
        {%- for p in bs -%}
          {%- if p.available and n < 4 -%}
            {%- assign n = n | plus: 1 -%}
            <div class="gcart-up-card">
              <a href="{{ p.url }}" class="gcart-up-img">{% if p.featured_media %}<img src="{{ p.featured_media | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy">{% endif %}</a>
              <div class="gcart-up-body">
                <a href="{{ p.url }}" class="gcart-up-name">{{ p.title }}</a>
                <div class="gcart-up-price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {%- endif -%}{{ p.price | money }}</div>
                <form action="{{ routes.cart_add_url }}" method="post">
                  <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="g-btn g-btn--outline gcart-up-add">+ Přidat</button>
                </form>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {% endif %}
</div>

<style>
.gcart-ship{ border:1px solid var(--line); border-radius:12px; padding:16px 18px; margin-bottom:24px; background:var(--paper); }
.gcart-ship-msg{ font-size:14.5px; margin-bottom:10px; }
.gcart-ship-track{ height:9px; border-radius:999px; background:var(--tag); overflow:hidden; }
.gcart-ship-fill{ height:100%; background:var(--ink); border-radius:999px; transition:width .4s ease; }
.gcart-row{ display:flex; gap:14px; padding:16px 0; border-bottom:1px solid var(--line); align-items:center; }
.gcart-row img{ width:64px; height:80px; object-fit:cover; border-radius:5px; display:block; }
.gcart-info{ flex:1; min-width:0; }
.gcart-name{ font-weight:600; color:var(--ink); text-decoration:none; }
.gcart-var{ font-size:12px; color:var(--ink-muted); margin-top:2px; }
.gcart-save{ font-size:12px; color:#c0392b; font-weight:600; margin-top:3px; }
.gcart-qty{ width:60px; padding:8px; border:1px solid var(--line); border-radius:6px; text-align:center; font:inherit; }
.gcart-price{ font-weight:700; min-width:84px; text-align:right; }
.gcart-remove{ color:var(--ink-muted); text-decoration:none; font-size:14px; padding:4px; }
.gcart-remove:hover{ color:var(--ink); }
.gcart-foot{ display:flex; justify-content:space-between; align-items:center; padding:22px 0 6px; gap:16px; flex-wrap:wrap; }
.gcart-foot-r{ display:flex; align-items:center; gap:18px; }
.gcart-total{ font-size:18px; }
.gcart-note{ font-size:12.5px; color:var(--ink-soft); }
.gcart-up{ margin-top:44px; border-top:1px solid var(--line); padding-top:28px; }
.gcart-up-title{ font-weight:800; font-size:20px; margin:0 0 18px; }
.gcart-up-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.gcart-up-card{ border:1px solid var(--line); border-radius:8px; overflow:hidden; display:flex; flex-direction:column; }
.gcart-up-img{ aspect-ratio:1/1; display:block; background:var(--tag); }
.gcart-up-img img{ width:100%; height:100%; object-fit:cover; display:block; }
.gcart-up-body{ padding:12px; display:flex; flex-direction:column; gap:6px; flex:1; }
.gcart-up-name{ font-size:14px; font-weight:600; color:var(--ink); text-decoration:none; }
.gcart-up-price{ font-size:14px; font-weight:600; }
.gcart-up-price s{ color:var(--ink-muted); font-weight:400; }
.gcart-up-add{ margin-top:auto; padding:9px 14px; font-size:13px; }
.gcart-empty{ color:var(--ink-soft); font-size:15px; margin:0 0 16px; }
.gcart-up-grid--4{ grid-template-columns:repeat(4,1fr); }
@media (max-width:900px){ .gcart-up-grid--4{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:640px){
  .gcart-up-grid{ grid-template-columns:1fr; }
  .gcart-foot{ flex-direction:column; align-items:stretch; }
  .gcart-foot-r{ justify-content:space-between; }
}
</style>
