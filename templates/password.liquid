<section class="gene-sec gene-wrap" style="text-align:center;padding:96px 24px">
  <div class="gene-logo" style="font-size:32px;margin-bottom:16px">{{ shop.name }}</div>
  <p style="color:var(--fg-2);margin-bottom:24px">Something big is dropping. Enter the password.</p>
  {% form 'storefront_password' %}
    <input type="password" name="password" placeholder="Password" style="padding:12px 16px;border:1.5px solid var(--aipa-ink);border-radius:999px;font:inherit">
    <button type="submit" class="gene-btn gene-btn--ink" style="margin-left:8px">Enter</button>
  {% endform %}
</section>