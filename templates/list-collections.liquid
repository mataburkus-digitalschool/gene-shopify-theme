<section class="gene-sec gene-wrap">
  <h2 style="margin-bottom:24px">All collections</h2>
  <div class="gene-cols" style="grid-template-columns:repeat(3,1fr);grid-template-rows:none">
    {%- for c in collections -%}
      <a href="{{ c.url }}" class="gene-col">{% if c.featured_image %}<img src="{{ c.featured_image | image_url: width: 800 }}" alt="{{ c.title }}">{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<div class="gene-col__cap"><span>{{ c.title }}</span></div></a>
    {%- endfor -%}
  </div>
</section>