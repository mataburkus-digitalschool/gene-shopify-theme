<section class="gene-sec gene-wrap">
  <h2 style="margin-bottom:16px">Search</h2>
  <form action="{{ routes.search_url }}" method="get" style="margin-bottom:24px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products…" style="width:100%;max-width:420px;padding:12px 16px;border:1.5px solid var(--aipa-ink);border-radius:999px;font:inherit">
  </form>
  {%- if search.performed -%}
    <div class="gene-grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- endif -%}
      {%- else -%}<p>No results for &ldquo;{{ search.terms }}&rdquo;.</p>{%- endfor -%}
    </div>
  {%- endif -%}
</section>