<div class="g-wrap" style="padding:48px 24px;max-width:420px;"><h1>Aktivace účtu</h1>{% form 'activate_customer_password' %}<div style="display:flex;flex-direction:column;gap:10px;"><input type="password" name="customer[password]" placeholder="Heslo" style="padding:12px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;"><input type="password" name="customer[password_confirmation]" placeholder="Potvrzení hesla" style="padding:12px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;"><button type="submit" class="g-btn">Aktivovat</button></div>{% endform %}</div>