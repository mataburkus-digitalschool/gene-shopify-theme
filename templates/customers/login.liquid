<section class="gene-sec gene-wrap" style="max-width:520px">
  <h1 style="font-family:var(--font-display);font-weight:800;font-size:clamp(26px,3vw,36px);letter-spacing:-.02em;margin-bottom:20px">Log in</h1>
  
{% form 'customer_login' %}
  {{ form.errors | default_errors }}
  <input type="email" name="customer[email]" placeholder="Email" style="width:100%;padding:12px 14px;border:1.5px solid var(--aipa-ink);border-radius:6px;font:inherit;margin-bottom:12px">
  <input type="password" name="customer[password]" placeholder="Password" style="width:100%;padding:12px 14px;border:1.5px solid var(--aipa-ink);border-radius:6px;font:inherit;margin-bottom:12px">
  <button type="submit" class="gene-add" style="width:auto;padding:13px 32px">Sign in</button>
{% endform %}
<p style="margin-top:16px;font-size:14px;color:var(--fg-2)">New here? <a href="{{ routes.account_register_url }}" style="border-bottom:1.5px solid var(--aipa-ink)">Create account</a></p>
</section>