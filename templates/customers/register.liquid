<div class="g-wrap" style="padding:48px 24px;max-width:420px;"><h1>Registrace</h1>{% form 'create_customer' %}<div style="display:flex;flex-direction:column;gap:10px;"><input type="email" name="customer[email]" placeholder="E-mail" style="padding:12px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;"><input type="password" name="customer[password]" placeholder="Heslo" style="padding:12px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;"><button type="submit" class="g-btn">Vytvořit účet</button></div>{% endform %}</div>