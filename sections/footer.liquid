<footer class="gene-footer" id="gf-{{ section.id }}">
  <div class="gene-wrap gene-footer__grid">
    <div class="gene-footer__brand">
      <div class="gene-logo" style="color:currentColor;margin-bottom:12px">{{ section.settings.brand_text }}</div>
      <p>{{ section.settings.tagline }}</p>
      <div style="display:flex;gap:12px">
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}">Instagram</a>{% endif %}
        {% if section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok }}">TikTok</a>{% endif %}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        <div class="gene-footer__links">
          {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  <div class="gene-wrap gene-footer__bottom">
    <span>{{ section.settings.copyright | default: '© ' | append: shop.name }} {{ 'now' | date: '%Y' }}</span>
    {% if section.settings.payment_text != blank %}<span style="font-family:var(--font-mono)">{{ section.settings.payment_text }}</span>{% endif %}
  </div>
</footer>
{% style %}#gf-{{ section.id }}{ {% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.text_color != blank %}color:{{ section.settings.text_color }};{% endif %} }
{% if section.settings.text_color != blank %}#gf-{{ section.id }} a,#gf-{{ section.id }} p{color:{{ section.settings.text_color }};opacity:.85}{% endif %}{% endstyle %}
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "GENE®"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Limited streetwear drops. Built different, worn loud. Thousands of customers worldwide."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Payment line",
      "default": "Visa · Mastercard · Amex · Apple Pay · Shop Pay · Klarna"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "menu"
        },
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}