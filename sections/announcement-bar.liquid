<div class="gene-annc" id="ga-{{ section.id }}">{{ section.settings.text }}</div>
{% style %}#ga-{{ section.id }}{ {% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.text_color != blank %}color:{{ section.settings.text_color }};{% endif %}{% if section.settings.font_size != blank %}font-size:{{ section.settings.font_size }}px;{% endif %} }{% endstyle %}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Free shipping over $75 · 14-day returns · Code <b>FAM10</b> — 10% off first drop</p>"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    }
  ]
}
{% endschema %}