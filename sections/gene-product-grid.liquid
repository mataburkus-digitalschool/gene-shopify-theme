{% comment %}
  GENE — Produktová mřížka
  Sekce pro Online Store 2.0 (přidejte soubor do sections/ ve vašem motivu).
  V editoru motivu: Přidat sekci → "GENE — Produktová mřížka".
{% endcomment %}

{%- liquid
  assign col = section.settings.collection
  assign btn_radius = section.settings.button_radius
  if btn_radius >= 40
    assign btn_radius_css = '999px'
  else
    assign btn_radius_css = btn_radius | append: 'px'
  endif
-%}

{% style %}
  #gene-grid-{{ section.id }} {
    max-width: 1200px; margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.ink }};
  }
  #gene-grid-{{ section.id }} .gg-head { margin-bottom: 24px; }
  #gene-grid-{{ section.id }} .gg-eyebrow { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.55); margin-bottom: 8px; }
  #gene-grid-{{ section.id }} .gg-title { font-weight: 800; font-size: clamp(28px, 3.4vw, 38px); letter-spacing: -0.02em; margin: 0; text-transform: uppercase; }
  #gene-grid-{{ section.id }} .gg-more { display: flex; justify-content: center; margin-top: 30px; }
  #gene-grid-{{ section.id }} .gg-viewall {
    display: inline-flex; align-items: center; gap: 10px;
    background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};
    border-radius: {{ btn_radius_css }}; padding: 14px 30px;
    font-size: 14px; font-weight: 700; text-decoration: none; white-space: nowrap;
    transition: background .2s cubic-bezier(.2,.8,.2,1), transform .08s;
  }
  #gene-grid-{{ section.id }} .gg-viewall svg { width: 16px; height: 16px; }
  #gene-grid-{{ section.id }} .gg-viewall:hover { background: {{ section.settings.button_bg_hover }}; }
  #gene-grid-{{ section.id }} .gg-viewall:active { transform: scale(0.98); }
  #gene-grid-{{ section.id }} .gg-grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 16px; }
  @media (min-width: 641px) and (max-width: 1000px) {
    #gene-grid-{{ section.id }} .gg-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    #gene-grid-{{ section.id }} .gg-grid { grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); gap: 8px; }
    #gene-grid-{{ section.id }} .gg-sizes { display: none; }
    #gene-grid-{{ section.id }} .gg-add-price { display: none; }
    #gene-grid-{{ section.id }} .gg-add { margin-top: 8px; }
  }
  #gene-grid-{{ section.id }} .gg-card {
    border: 1px solid #DDDDDD; border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden; background:var(--paper); display: flex; flex-direction: column;
    transition: border-color .2s cubic-bezier(.2,.8,.2,1);
  }
  #gene-grid-{{ section.id }} .gg-card:hover { border-color: {{ section.settings.ink }}; }
  #gene-grid-{{ section.id }} .gg-mediawrap { position: relative; }
  #gene-grid-{{ section.id }} .gg-media { position: relative; display: block; aspect-ratio: 1/1; background: #EFEFEF; overflow: hidden; }
  #gene-grid-{{ section.id }} .gg-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #gene-grid-{{ section.id }} .gg-qabtn {
    position: absolute; right: 10px; bottom: 10px; z-index: 2; border: none; cursor: pointer;
    width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; background: rgba(227,226,222,.92); color: {{ section.settings.ink }};
    box-shadow: 0 2px 10px rgba(0,0,0,.14);
    transition: transform .2s cubic-bezier(.2,.8,.2,1), background .2s cubic-bezier(.2,.8,.2,1);
  }
  #gene-grid-{{ section.id }} .gg-qabtn svg { width: 18px; height: 18px; display: block; }
  #gene-grid-{{ section.id }} .gg-card:hover .gg-qabtn { transform: scale(1.1); background: #fff; }
  @media (max-width: 640px) {
    #gene-grid-{{ section.id }} .gg-qabtn { width: 28px; height: 28px; right: 7px; bottom: 7px; }
    #gene-grid-{{ section.id }} .gg-qabtn svg { width: 15px; height: 15px; }
  }
  #gene-grid-{{ section.id }} .gg-img2 { opacity: 0; transition: opacity .3s cubic-bezier(.2,.8,.2,1); }
  #gene-grid-{{ section.id }} .gg-card:hover .gg-img2 { opacity: 1; }
  #gene-grid-{{ section.id }} .gg-soldout-img { opacity: 0.5; }
  #gene-grid-{{ section.id }} .gg-badge {
    position: absolute; top: 10px; left: 10px; z-index: 2;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 10px; font-weight: 600;
    letter-spacing: 0.08em; padding: 5px 11px; border-radius: 999px; text-transform: uppercase;
    background: {{ section.settings.ink }}; color: #fff;
  }
  #gene-grid-{{ section.id }} .gg-badge--out { background:var(--paper); color: {{ section.settings.ink }}; border: 1px solid {{ section.settings.ink }}; font-weight: 700; letter-spacing: 0.1em; }
  #gene-grid-{{ section.id }} .gg-badge--low { top: auto; bottom: 10px; background: rgba(26,26,26,0.9); letter-spacing: 0.06em; }
  #gene-grid-{{ section.id }} .gg-info { padding: 13px 13px 15px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
  #gene-grid-{{ section.id }} .gg-name { font-weight: 600; font-size: 14px; line-height: 1.25; color: inherit; text-decoration: none; }
  #gene-grid-{{ section.id }} .gg-prices { display: flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; }
  #gene-grid-{{ section.id }} .gg-price { font-weight: 700; font-size: 15px; white-space: nowrap; }
  #gene-grid-{{ section.id }} .gg-compare { font-size: 13px; color: rgba(0,0,0,0.45); white-space: nowrap; }
  #gene-grid-{{ section.id }} .gg-sizes { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; margin-top: auto; }
  #gene-grid-{{ section.id }} .gg-size {
    padding: 6px 0; text-align: center; font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10.5px; border-radius: 4px; cursor: pointer; border: 1px solid #DDDDDD;
    background:var(--paper); color: inherit; transition: all .15s cubic-bezier(.2,.8,.2,1);
  }
  #gene-grid-{{ section.id }} .gg-size[disabled] { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }
  #gene-grid-{{ section.id }} .gg-size.is-active { background: {{ section.settings.ink }}; border-color: {{ section.settings.ink }}; color: #fff; }
  #gene-grid-{{ section.id }} .gg-add {
    margin-top: auto; width: 100%; box-sizing: border-box; text-align: center; text-decoration: none; display: block;
    background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text }};
    border: none; border-radius: {{ btn_radius_css }}; padding: 10px;
    font-weight: 700; font-size: 13px; cursor: pointer; font-family: inherit;
    transition: background .2s cubic-bezier(.2,.8,.2,1), transform .08s;
  }
  #gene-grid-{{ section.id }} .gg-sizes + .gg-add { margin-top: 6px; }
  #gene-grid-{{ section.id }} .gg-add:hover { background: {{ section.settings.button_bg_hover }}; }
  #gene-grid-{{ section.id }} .gg-add:active { transform: scale(0.98); }
  #gene-grid-{{ section.id }} .gg-add--out {
    background:var(--paper); color: {{ section.settings.ink }}; border: 1.5px solid {{ section.settings.ink }};
    cursor: default; font-size: 12.5px;
  }
  #gene-grid-{{ section.id }} .gg-add--out:hover { background:var(--paper); }
{% endstyle %}

<div id="gene-grid-{{ section.id }}" data-cart-add-url="{{ routes.cart_add_url }}">
  <div class="gg-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <div class="gg-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="gg-title">{{ section.settings.title }}</h2>
    </div>
  </div>

  <div class="gg-grid">
    {%- if col != blank -%}
      {%- for product in col.products limit: section.settings.products_to_show -%}
        {%- liquid
          assign on_sale = false
          if product.compare_at_price > product.price
            assign on_sale = true
          endif
          assign sold_out = false
          unless product.available
            assign sold_out = true
          endunless
          assign is_new = false
          if section.settings.show_new_badge and product.tags contains 'new'
            assign is_new = true
          endif
          assign fav = product.selected_or_first_available_variant
          assign low_qty = 0
          if section.settings.low_stock_threshold > 0 and sold_out == false and fav.inventory_management != blank and fav.inventory_quantity > 0 and fav.inventory_quantity <= section.settings.low_stock_threshold
            assign low_qty = fav.inventory_quantity
          endif
        -%}
        <div class="gg-card" data-product data-default-variant="{{ fav.id }}">
          {%- comment -%} ikona košíku stojí vedle odkazu, ne v něm {%- endcomment -%}
          <div class="gg-mediawrap">
          <a class="gg-media" href="{{ product.url }}">
            {%- if product.featured_media -%}
              <img src="{{ product.featured_media | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy" width="700" height="700"{% if sold_out %} class="gg-soldout-img"{% endif %}>
            {%- endif -%}
            {%- if section.settings.show_secondary_image and product.media[1] -%}
              <img class="gg-img2" src="{{ product.media[1] | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="700">
            {%- endif -%}
            {%- if sold_out and section.settings.show_soldout_badge -%}
              <span class="gg-badge gg-badge--out">{{ section.settings.soldout_label }}</span>
            {%- elsif on_sale and section.settings.show_sale_badge -%}
              <span class="gg-badge">Sale</span>
            {%- elsif is_new -%}
              <span class="gg-badge">NEW</span>
            {%- endif -%}
            {%- if low_qty > 0 -%}
              <span class="gg-badge gg-badge--low">{{ section.settings.low_stock_label | replace: '[n]', low_qty }}</span>
            {%- endif -%}
          </a>
          {%- if section.settings.show_quick_add and sold_out == false -%}
            <button class="gg-qabtn" type="button" data-qa-open aria-label="Přidat {{ product.title | escape }} do košíku">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 8.5h11v10a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5v-10Z"/><path d="M7.5 8.5V6.5a2.5 2.5 0 0 1 5 0v2"/><path d="M19 3.5v5M16.5 6h5"/></svg>
            </button>
          {%- endif -%}
          </div>
          <div class="gg-info">
            <a class="gg-name" href="{{ product.url }}">{{ product.title }}</a>
            <div class="gg-prices">
              <span class="gg-price">{{ product.price | money }}</span>
              {%- if on_sale -%}<s class="gg-compare">{{ product.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {%- if sold_out -%}
              <button class="gg-add gg-add--out" type="button" disabled>{{ section.settings.soldout_button_label }}</button>
            {%- else -%}
              {%- comment -%}
                Textové tlačítko vede na produkt; do košíku se přidává ikonou
                nad ním, která otevře výběr velikosti.
              {%- endcomment -%}
              <a class="gg-add" href="{{ product.url }}">{{ section.settings.preview_label | default: "View product" }}</a>
              <script type="application/json" class="gg-qa">{"name":{{ product.title | json }},"price":{{ product.price | money | json }},"compare":{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},"img":{{ product.featured_media | image_url: width: 320 | json }},"url":{{ product.url | json }},"singleVariant":{{ product.has_only_default_variant }},"options":[{%- for o in product.options_with_values -%}{"name":{{ o.name | json }},"values":{{ o.values | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"variants":[{%- for v in product.variants -%}{"id":{{ v.id }},"opts":{{ v.options | json }},"available":{{ v.available }},"img":{% if v.featured_media %}{{ v.featured_media | image_url: width: 400 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="gg-card">
          <div class="gg-media">{{ 'product-apparel-1' | placeholder_svg_tag: 'gg-placeholder' }}</div>
          <div class="gg-info">
            <span class="gg-name">Příklad produktu</span>
            <div class="gg-prices"><span class="gg-price">890 Kč</span></div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and col != blank -%}
    {%- comment -%} odkaz na celou kolekci patří pod produkty, ne k nadpisu {%- endcomment -%}
    <div class="gg-more">
      <a class="gg-viewall" href="{{ col.url }}">
        {{ section.settings.view_all_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  {%- endif -%}
</div>



{% schema %}
{
  "name": "GENE — Produktová mřížka",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Obsah" },
    { "type": "text", "id": "eyebrow", "label": "Nadpis nad titulkem (eyebrow)", "default": "On sale now · while stock lasts" },
    { "type": "text", "id": "title", "label": "Titulek sekce", "default": "Summer Archive" },
    { "type": "collection", "id": "collection", "label": "Kolekce" },
    { "type": "range", "id": "products_to_show", "label": "Počet produktů", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Zobrazit odkaz „Zobrazit vše“", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Text odkazu", "default": "View all" },

    { "type": "header", "content": "Mřížka" },
    { "type": "range", "id": "columns_desktop", "label": "Sloupce (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Sloupce (mobil)", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ], "default": "2" },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Druhá fotka při najetí myší", "default": true },

    { "type": "header", "content": "Štítky (badges)" },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Štítek slevy (−%)", "default": true },
    { "type": "checkbox", "id": "show_new_badge", "label": "Štítek NEW (produkty s tagem „new“)", "default": true },
    { "type": "checkbox", "id": "show_soldout_badge", "label": "Štítek vyprodáno", "default": true },
    { "type": "text", "id": "soldout_label", "label": "Text štítku vyprodáno", "default": "SOLD OUT" },
    { "type": "range", "id": "low_stock_threshold", "label": "Práh „posledních kusů“ (0 = vypnuto)", "min": 0, "max": 10, "step": 1, "default": 3 },
    { "type": "text", "id": "low_stock_label", "label": "Text nízké zásoby ([n] = počet)", "default": "Only [n] left" },

    { "type": "header", "content": "Rychlé přidání do košíku" },
    { "type": "checkbox", "id": "show_sizes", "label": "Výběr velikosti (varianta „Size“ / „Velikost“)", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Ikona rychlého přidání ve fotce", "default": true },
    { "type": "text", "id": "preview_label", "label": "Text tlačítka pod cenou", "default": "View product" },
    { "type": "text", "id": "added_label", "label": "Text po přidání", "default": "✓ Přidáno" },
    { "type": "text", "id": "soldout_button_label", "label": "Text tlačítka u vyprodaného", "default": "Vyprodáno" },
    { "type": "text", "id": "select_size_label", "label": "Nadpis výběru velikosti (modal)", "default": "Select size" },
    { "type": "text", "id": "size_oos_label", "label": "Text vyprodané velikosti (modal)", "default": "Out of stock" },

    { "type": "header", "content": "Styl tlačítek a karet" },
    { "type": "color", "id": "ink", "label": "Základní barva (text, rámečky, štítky)", "default": "#1A1A1A" },
    { "type": "color", "id": "button_bg", "label": "Tlačítko — pozadí", "default": "#1A1A1A" },
    { "type": "color", "id": "button_bg_hover", "label": "Tlačítko — pozadí (hover)", "default": "#000000" },
    { "type": "color", "id": "button_text", "label": "Tlačítko — text", "default": "#FFFFFF" },
    { "type": "range", "id": "button_radius", "label": "Zaoblení tlačítka (40 = pilulka)", "min": 0, "max": 40, "step": 2, "default": 40 },
    { "type": "range", "id": "card_radius", "label": "Zaoblení karty", "min": 0, "max": 20, "step": 1, "default": 6 },

    { "type": "header", "content": "Odsazení sekce" },
    { "type": "range", "id": "padding_top", "label": "Horní odsazení", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Dolní odsazení", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "presets": [
    { "name": "GENE — Produktová mřížka" }
  ]
}
{% endschema %}
