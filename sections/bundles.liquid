{% render 'section-css', id: section.id, s: section.settings %}
{%- assign demo_bundles = 'Gene Harakuja Hoodie + Gene Pattern Sweatpants~74~84~https://genestreetwear.com/cdn/shop/files/Jewellery-12.png?width=800|Gene R Tee + Gene NN Tee~52~62~https://genestreetwear.com/cdn/shop/files/use_the_first_image_as_the_reference_for_the_scene_composition_camera_angle_lighting_shadows_floor__urbmn19h8pv3j2yq4nhl_0.png?width=800|Gene Security Hoodie + Gene RR Shorts~79~94~https://genestreetwear.com/cdn/shop/files/the_first_image_is_the_only_reference_for_the_scene_background_floor_lighting_shadows_camera_angle__enm7yj19q04ht472syac_0.png?width=800' | split: '|' -%}
<section id="gs-{{ section.id }}" class="gene-sec gene-wrap">
  {% if section.settings.anchor != blank %}<span id="{{ section.settings.anchor }}"></span>{% endif %}
  <div class="gene-sechead"><div>
    {% if section.settings.kicker != blank %}<div class="gene-kicker">{{ section.settings.kicker }}</div>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
  </div></div>
  <div class="gene-bundles" style="{% if section.settings.columns != blank %}grid-template-columns:repeat({{ section.settings.columns }},1fr);{% endif %}">
    {%- for block in section.blocks -%}
      {%- assign pa = block.settings.product_a -%}{%- assign pb = block.settings.product_b -%}{%- assign pc = block.settings.product_c -%}
      {%- assign regular = 0 -%}{%- assign variants = '' -%}{%- assign contents = '' -%}
      {%- if pa != blank -%}{%- assign regular = regular | plus: pa.price -%}{%- assign variants = variants | append: pa.selected_or_first_available_variant.id | append: ',' -%}{%- assign contents = contents | append: pa.title -%}{%- endif -%}
      {%- if pb != blank -%}{%- assign regular = regular | plus: pb.price -%}{%- assign variants = variants | append: pb.selected_or_first_available_variant.id | append: ',' -%}{%- assign contents = contents | append: ' + ' | append: pb.title -%}{%- endif -%}
      {%- if pc != blank -%}{%- assign regular = regular | plus: pc.price -%}{%- assign variants = variants | append: pc.selected_or_first_available_variant.id | append: ',' -%}{%- assign contents = contents | append: ' + ' | append: pc.title -%}{%- endif -%}
      {%- assign di = forloop.index0 | modulo: 3 -%}
      {%- assign dparts = demo_bundles[di] | split: '~' -%}
      {%- if regular > 0 -%}
        {%- assign discount = regular | times: block.settings.discount_percent | divided_by: 100.0 | round -%}
        {%- assign bundle_price = regular | minus: discount -%}
        {%- if block.settings.fixed_price > 0 -%}{%- assign bundle_price = block.settings.fixed_price | times: 100 -%}{%- endif -%}
        {%- assign saved = regular | minus: bundle_price -%}
      {%- endif -%}
      <div class="gene-bundle" {{ block.shopify_attributes }}>
        <div class="gene-bundle__media">
          {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}">
          {%- elsif pa.featured_media -%}<img src="{{ pa.featured_media | image_url: width: 800 }}" alt="{{ block.settings.title }}">
          {%- else -%}<img src="{{ dparts[3] }}" alt="{{ block.settings.title }}">{%- endif -%}
          {%- if regular > 0 and saved > 0 -%}<span class="gene-badge">SAVE {{ saved | money }}</span>
          {%- elsif regular == 0 -%}{%- assign dsave = dparts[2] | plus: 0 | minus: dparts[1] -%}<span class="gene-badge">SAVE ${{ dsave }}.00</span>{%- endif -%}
        </div>
        <div class="gene-bundle__body">
          {% if block.settings.tag != blank %}<div class="gene-kicker" style="margin:0">{{ block.settings.tag }}</div>{% endif %}
          <div style="font-family:var(--font-display);font-weight:700;font-size:18px;line-height:1.2">{{ block.settings.title }}</div>
          {%- if block.settings.description != blank -%}<div class="gene-bundle__contents">{{ block.settings.description }}</div>
          {%- elsif contents != '' -%}<div class="gene-bundle__contents">{{ contents }}</div>
          {%- else -%}<div class="gene-bundle__contents">{{ dparts[0] }}</div>{%- endif -%}
          {%- if regular > 0 -%}
            <div class="gene-price" style="margin-top:auto"><b style="font-size:20px">{{ bundle_price | money }}</b>{% if saved > 0 %}<s style="font-size:14px">{{ regular | money }}</s>{% endif %}</div>
            <button class="gene-add" data-bundle-add data-variants="{{ variants | strip }}">{{ block.settings.button_text | default: 'Add set' }} &mdash; {{ bundle_price | money }}</button>
          {%- else -%}
            <div class="gene-price" style="margin-top:auto"><b style="font-size:20px">${{ dparts[1] }}.00</b><s style="font-size:14px">${{ dparts[2] }}.00</s></div>
            <button class="gene-add" data-bundle-add>{{ block.settings.button_text | default: 'Add set' }} &mdash; ${{ dparts[1] }}.00</button>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Bundles",
  "settings": [
    {
      "type": "paragraph",
      "content": "Demo GENE sets show until you pick products per bundle."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "bundles"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Buy the set · save more"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundles & Sets"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "2-Piece Set"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Head-to-Toe Set"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        },
        {
          "type": "product",
          "id": "product_a",
          "label": "Product A"
        },
        {
          "type": "product",
          "id": "product_b",
          "label": "Product B"
        },
        {
          "type": "product",
          "id": "product_c",
          "label": "Product C (optional)"
        },
        {
          "type": "range",
          "id": "discount_percent",
          "label": "Discount %",
          "min": 0,
          "max": 50,
          "step": 5,
          "default": 10
        },
        {
          "type": "number",
          "id": "fixed_price",
          "label": "Fixed price (overrides %)"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Add set"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "tag": "2-Piece Set",
            "title": "Head-to-Toe Set"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Tee 2-Pack",
            "title": "Summer Tee Pack"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Full Fit",
            "title": "Full Drip Bundle"
          }
        }
      ]
    }
  ]
}
{% endschema %}