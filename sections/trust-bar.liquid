{% render 'section-css', id: section.id, s: section.settings %}
<section id="gs-{{ section.id }}" class="gene-trust"><div class="gene-wrap gene-trust__grid">
  {%- for block in section.blocks -%}
    <div class="gene-trust__c" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b>{{ block.settings.sub }}</div>
  {%- endfor -%}
</div></section>
{% schema %}
{
  "name": "Trust bar",
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Limited Drops"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtitle",
          "default": "No restock, ever"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Limited Drops",
            "sub": "No restock, ever"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Fast Shipping",
            "sub": "5–10 day worldwide"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "14-Day Returns",
            "sub": "Easy, no drama"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Secure Checkout",
            "sub": "Apple · Google · Shop Pay"
          }
        }
      ]
    }
  ]
}
{% endschema %}