<section class="gtp" style="background:{{ section.settings.bg | default: '#E3E2DE' }};padding:26px 24px;">
  <div class="gtp-in">
    <strong class="gtp-word">{{ section.settings.word | default: 'Excellent' }}</strong>
    <span class="gtp-stars" aria-hidden="true">
      {%- for i in (1..5) -%}<span class="gtp-star">★</span>{%- endfor -%}
    </span>
    <span class="gtp-sub">{{ section.settings.rating | default: '4.9' }} out of 5 based on <b>{{ section.settings.count | default: '1000+' }} reviews</b> on <span class="gtp-tp"><span class="gtp-tp-i">★</span> Trustpilot</span></span>
  </div>
</section>
<style>
.gtp-in{ display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:12px; text-align:center; }
.gtp-word{ font-size:22px; font-weight:800; letter-spacing:-0.01em; }
.gtp-stars{ display:inline-flex; gap:3px; }
.gtp-star{ background:#00b67a; color:#fff; width:26px; height:26px; display:inline-flex; align-items:center; justify-content:center; font-size:15px; border-radius:3px; }
.gtp-sub{ font-size:15px; color:var(--ink); }
.gtp-tp{ font-weight:700; white-space:nowrap; }
.gtp-tp-i{ color:#00b67a; }
@media (max-width:600px){ .gtp-word{ font-size:18px; } .gtp-sub{ font-size:13px; } }
</style>
{% schema %}
{
  "name": "GENE — Trustpilot",
  "settings": [
    { "type": "text", "id": "word", "label": "Slovo", "default": "Excellent" },
    { "type": "text", "id": "rating", "label": "Hodnocení", "default": "4.9" },
    { "type": "text", "id": "count", "label": "Počet recenzí", "default": "1000+" },
    { "type": "color", "id": "bg", "label": "Pozadí", "default": "#E3E2DE" }
  ],
  "presets": [ { "name": "GENE — Trustpilot" } ]
}
{% endschema %}
