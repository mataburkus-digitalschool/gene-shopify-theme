{% render 'section-css', id: section.id, s: section.settings %}
<section id="gs-{{ section.id }}" class="gene-sec gene-wrap">
  <h2 style="text-align:center;margin-bottom:24px">{{ section.settings.heading }}</h2>
  <div>
    {%- for block in section.blocks -%}
      <div class="gene-faq__item{% if forloop.first and section.settings.open_first %} is-open{% endif %}" {{ block.shopify_attributes }}>
        <button class="gene-faq__q">{{ block.settings.question }}<span class="ic">+</span></button>
        <div class="gene-faq__a">{{ block.settings.answer }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item",
      "default": true
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "q",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "q",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "Shipping is 5–10 working days to almost every country we service. A tracking number lands in your inbox the moment your order ships."
          }
        },
        {
          "type": "q",
          "settings": {
            "question": "What is your return policy?",
            "answer": "Returns are easy: request within 14 days of delivery. Once we receive and inspect the item, we process your refund."
          }
        },
        {
          "type": "q",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "Yes — we ship to over 50 countries worldwide. International times vary slightly by location."
          }
        },
        {
          "type": "q",
          "settings": {
            "question": "Are your products restocked?",
            "answer": "No. Every drop is limited — once it's gone, it's gone for good."
          }
        },
        {
          "type": "q",
          "settings": {
            "question": "How do I pick the right size?",
            "answer": "Every product page has a full size guide. Fits run true to a relaxed streetwear cut."
          }
        }
      ]
    }
  ]
}
{% endschema %}