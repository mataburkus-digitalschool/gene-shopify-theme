<footer style="background:var(--ink);color:#fff;margin-top:40px;padding:56px 24px 28px;">
  <div class="g-wrap gfoot-grid">
    <div>
      <img src="{{ 'gene-logo.png' | asset_url }}" alt="{{ section.settings.brand | default: shop.name }}" style="height:34px;width:auto;display:block;filter:invert(1) brightness(2);margin-bottom:14px;">
      <p style="font-size:13px;color:rgba(255,255,255,0.6);max-width:260px;line-height:1.55;margin:0;">{{ section.settings.text }}</p>
    </div>

    <div>
      <h4 class="gfoot-h">{{ section.settings.policies_heading }}</h4>
      <div class="gfoot-links">
        {%- if section.settings.contact_url != blank -%}<a href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a>{%- endif -%}
        {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">Refund Policy</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{%- endif -%}
        {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping Policy</a>{%- endif -%}
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}
        {%- if shop.subscription_policy != blank -%}<a href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a>{%- endif -%}
      </div>
    </div>

    <div>
      <h4 class="gfoot-h">{{ section.settings.contact_heading }}</h4>
      <div class="gfoot-links">
        <span style="color:rgba(255,255,255,0.65);">{{ section.settings.contact_intro }}</span>
        {%- if section.settings.contact_email != blank -%}<a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>{%- endif -%}
      </div>
    </div>

    <div>
      <h4 class="gfoot-h">{{ section.settings.links_heading }}</h4>
      <div class="gfoot-links">
        {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      <h4 class="gfoot-h">{{ block.settings.heading }}</h4>
      <div class="gfoot-links">
        {%- for link in block.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
    {%- endfor -%}
  </div>

  <div class="g-wrap" style="margin-top:36px;border-top:1px solid rgba(255,255,255,0.15);padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:rgba(255,255,255,0.5);">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}</span>
    <span style="font-family:var(--mono);">Designed by Matija Burkuš</span>
    <span style="font-family:var(--mono);">{{ section.settings.payments }}</span>
  </div>
</footer>
<style>
.gfoot-grid { display:flex; flex-wrap:wrap; gap:36px 56px; align-items:flex-start; }
.gfoot-grid > div:first-child { flex:1 1 240px; min-width:220px; max-width:320px; }
.gfoot-grid > div { flex:0 0 auto; }
.gfoot-h { font-family:var(--mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.5); margin:0 0 14px; }
.gfoot-links { display:flex; flex-direction:column; gap:9px; font-size:13.5px; }
.gfoot-links a { color:rgba(255,255,255,0.85); text-decoration:none; }
.gfoot-links a:hover { color:#fff; text-decoration:underline; }
@media (max-width:900px){ .gfoot-grid{ gap:28px 40px; } .gfoot-grid > div:first-child{ flex-basis:100%; max-width:none; } }
</style>
{% schema %}
{
  "name": "Patička",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Značka",
      "default": "GENE®"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text pod logem",
      "default": "Limited streetwear drops. Built different, worn loud. Thousands of customers worldwide."
    },
    {
      "type": "header",
      "content": "Sloupec: Policies"
    },
    {
      "type": "text",
      "id": "policies_heading",
      "label": "Nadpis",
      "default": "Policies"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact Information — odkaz",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact Information — text",
      "default": "Contact Information"
    },
    {
      "type": "header",
      "content": "Sloupec: Contact Us"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Nadpis",
      "default": "Contact Us:"
    },
    {
      "type": "text",
      "id": "contact_intro",
      "label": "Popisek",
      "default": "Email us at:"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "E-mail",
      "default": "support@genestreetwear.com"
    },
    {
      "type": "header",
      "content": "Sloupec: Our Links"
    },
    {
      "type": "text",
      "id": "links_heading",
      "label": "Nadpis",
      "default": "Our Links:"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL",
      "default": "https://www.tiktok.com/@genestreetwear"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/genestreetwear"
    },
    {
      "type": "header",
      "content": "Dole"
    },
    {
      "type": "text",
      "id": "payments",
      "label": "Platební metody",
      "default": "Visa · Mastercard · Amex · Apple Pay · Shop Pay · Klarna"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Sloupec menu (volitelné)",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Nadpis",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}

