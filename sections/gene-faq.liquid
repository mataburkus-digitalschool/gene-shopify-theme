<section class="g-wrap" style="padding:64px 24px 8px;max-width:860px;">
  <h2 class="g-h2" style="margin-bottom:24px;text-align:center;">{{ section.settings.title }}</h2>
  <div>
    {%- for block in section.blocks -%}
    <details {{ block.shopify_attributes }} class="gfaq" style="border-bottom:1px solid var(--line);">
      <summary style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 4px;cursor:pointer;font-weight:600;font-size:16px;list-style:none;">
        {{ block.settings.q }}<span class="gfaq-i" style="font-size:22px;font-weight:400;line-height:1;color:var(--ink-muted);transition:transform .2s var(--ease);">+</span>
      </summary>
      <div style="font-size:14.5px;line-height:1.6;color:var(--ink-soft);padding:0 4px 18px;">{{ block.settings.a }}</div>
    </details>
    {%- endfor -%}
  </div>
</section>
<style>
.gfaq summary::-webkit-details-marker { display:none; }
.gfaq[open] .gfaq-i { transform:rotate(45deg); color:var(--ink); }
</style>
{% schema %}
{
  "name": "GENE — FAQ",
  "tag": "section",
  "settings": [ { "type": "text", "id": "title", "label": "Titulek", "default": "Frequently asked" } ],
  "blocks": [
    { "type": "qa", "name": "Otázka", "settings": [
      { "type": "text", "id": "q", "label": "Otázka", "default": "How long does shipping take?" },
      { "type": "textarea", "id": "a", "label": "Odpověď", "default": "Shipping is 5–10 working days to almost every country we service." }
    ] }
  ],
  "presets": [ { "name": "GENE — FAQ", "blocks": [
    { "type": "qa" },
    { "type": "qa", "settings": { "q": "What is your return policy?", "a": "Returns are easy: request within 14 days of delivery. Once we receive and inspect the item, we process your refund." } },
    { "type": "qa", "settings": { "q": "Do you ship internationally?", "a": "Yes — we ship to over 50 countries worldwide. International times vary slightly by location." } },
    { "type": "qa", "settings": { "q": "Are your products restocked?", "a": "No. Every drop is limited — once it's gone, it's gone for good." } },
    { "type": "qa", "settings": { "q": "How do I pick the right size?", "a": "Every product page has a full size guide. Fits run true to a relaxed streetwear cut." } }
  ] } ]
}
{% endschema %}