{%- liquid
  assign cat_labels = 'Tees,Hoodies,Bottoms,Shorts' | split: ','
  assign cat_handles = 'tees,hoodies,bottoms,shorts' | split: ','
  assign use_cat_menu = false
  if section.settings.category_menu != blank and section.settings.category_menu.links.size > 0
    assign use_cat_menu = true
  endif
-%}
<input type="checkbox" id="gh-toggle-{{ section.id }}" class="gh-toggle" hidden>
<header style="position:sticky;top:0;z-index:50;background:rgba(227,226,222,0.92);backdrop-filter:blur(10px) saturate(140%);-webkit-backdrop-filter:blur(10px) saturate(140%);border-bottom:1px solid var(--line);">
  <div class="g-wrap gh-bar">
    <!-- left: menu -->
    <div class="gh-side gh-side--left">
      <label for="gh-toggle-{{ section.id }}" class="gh-burger" aria-label="Menu"><span></span><span></span><span></span></label>
    </div>

    <!-- center: logo + tagline -->
    <a href="{{ routes.root_url }}" class="gh-logo" style="text-decoration:none;">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:{{ section.settings.logo_height }}px;width:auto;display:block;">
      {%- else -%}
        <img src="{{ 'gene-logo.png' | asset_url }}" alt="{{ section.settings.logo_text | default: shop.name }}" style="height:{{ section.settings.logo_height }}px;width:auto;display:block;">
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <span class="gh-tagline">{{ section.settings.tagline }}</span>
      {%- endif -%}
    </a>

    <!-- right: search + cart -->
    <div class="gh-side gh-side--right">
      <a href="{{ routes.search_url }}" class="gh-ico" aria-label="{{ section.settings.search_label | default: 'Search' }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="gh-ico gh-cart" aria-label="{{ section.settings.cart_label | default: 'Cart' }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span data-cart-count class="gh-count{% if cart.item_count == 0 %} is-empty{% endif %}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <!-- slide-down menu (all screen sizes) -->
  <div class="gh-mobile">
    <nav class="gh-mnav">
      {%- for link in section.settings.menu.links -%}
        {%- assign lt = link.title | downcase -%}
        {%- unless lt == 'contact' or lt == 'kontakt' or link.url contains '/pages/contact' -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endunless -%}
      {%- endfor -%}
      {%- if use_cat_menu -%}
        {%- for link in section.settings.category_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}
        {%- for label in cat_labels -%}<a href="{{ routes.root_url }}collections/{{ cat_handles[forloop.index0] }}">{{ label }}</a>{%- endfor -%}
      {%- endif -%}
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">{{ section.settings.contact_label | default: 'Contact' }}</a>
    </nav>
    <div class="gh-mactions">
      <a href="{{ routes.cart_url }}" class="gh-mact gh-mact--primary">{{ section.settings.cart_label }} <span>({{ cart.item_count }})</span></a>
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}" class="gh-mact">{{ section.settings.profile_label }}</a>{%- endif -%}
    </div>
  </div>
</header>
<style>
  .gh-bar { height:76px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; }
  .gh-side { display:flex; align-items:center; }
  .gh-side--left { justify-content:flex-start; }
  .gh-side--right { justify-content:flex-end; gap:18px; }

  .gh-logo { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; }
  .gh-tagline { font-family:var(--mono); font-size:10.5px; letter-spacing:0.34em; text-transform:uppercase; color:var(--ink); padding-left:0.34em; }

  .gh-ico { display:inline-flex; align-items:center; justify-content:center; color:var(--ink); text-decoration:none; }
  .gh-ico svg { width:23px; height:23px; display:block; }
  .gh-cart { position:relative; }
  .gh-count { position:absolute; top:-6px; right:-8px; min-width:16px; height:16px; display:inline-flex; align-items:center; justify-content:center; background:var(--ink); color:var(--paper); border-radius:999px; font-size:10px; font-weight:700; font-variant-numeric:tabular-nums; padding:0 4px; }
  .gh-count.is-empty { display:none; }

  .gh-burger { display:flex; flex-direction:column; justify-content:center; gap:5px; width:28px; height:28px; cursor:pointer; }
  .gh-burger span { display:block; height:2px; width:24px; background:var(--ink); border-radius:2px; transition:transform .22s var(--ease), opacity .18s; }
  .gh-toggle:checked ~ header .gh-burger span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
  .gh-toggle:checked ~ header .gh-burger span:nth-child(2){ opacity:0; }
  .gh-toggle:checked ~ header .gh-burger span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }

  .gh-mobile { display:none; border-top:1px solid var(--line); background:var(--paper); padding:6px 24px 22px; }
  .gh-toggle:checked ~ header .gh-mobile { display:block; }
  .gh-mnav { display:flex; flex-direction:column; }
  .gh-mnav a { padding:15px 4px; font-weight:700; font-size:16px; text-transform:uppercase; letter-spacing:0.02em; text-decoration:none; color:var(--ink); border-bottom:1px solid var(--line); }
  .gh-mactions { display:flex; gap:10px; margin-top:18px; }
  .gh-mact { flex:1; display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:14px; border-radius:999px; font-weight:700; font-size:14px; text-decoration:none; }
  .gh-mact--primary { background:var(--ink); color:#fff; }
  .gh-mact:not(.gh-mact--primary) { background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); }

  @media (max-width:600px){
    .gh-bar { height:64px; }
    .gh-side--right { gap:14px; }
  }
</style>
{% schema %}
{
  "name": "Hlavička",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (obrázek)" },
    { "type": "range", "id": "logo_height", "label": "Výška loga", "min": 18, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "text", "id": "logo_text", "label": "Text loga (pokud není obrázek)", "default": "GENE®" },
    { "type": "text", "id": "tagline", "label": "Tagline pod logem", "default": "STREETWEAR" },
    { "type": "link_list", "id": "menu", "label": "Hlavní menu", "default": "main-menu" },
    { "type": "link_list", "id": "category_menu", "label": "Menu kategorií (jinak Tees/Hoodies/Bottoms/Shorts)" },
    { "type": "text", "id": "search_label", "label": "Popisek hledání", "default": "Search" },
    { "type": "text", "id": "login_label", "label": "Text přihlášení", "default": "Log in" },
    { "type": "text", "id": "cart_label", "label": "Text košíku", "default": "Cart" },
    { "type": "text", "id": "profile_label", "label": "Text profilu (mobil)", "default": "Profil" },
    { "type": "text", "id": "contact_label", "label": "Kontakt — text", "default": "Contact" },
    { "type": "url", "id": "contact_url", "label": "Kontakt — odkaz", "default": "/pages/contact" }
  ]
}
{% endschema %}
