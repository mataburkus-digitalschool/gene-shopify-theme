{%- liquid
  assign cat_labels = 'Tees,Hoodies,Bottoms,Shorts' | split: ','
  assign cat_handles = 'tees,hoodies,bottoms,shorts' | split: ','
  assign use_cat_menu = false
  if section.settings.category_menu != blank and section.settings.category_menu.links.size > 0
    assign use_cat_menu = true
  endif
-%}
<input type="checkbox" id="gh-toggle-{{ section.id }}" class="gh-toggle" hidden>
<header style="position:sticky;top:0;z-index:50;background:rgba(250,250,250,0.9);backdrop-filter:blur(10px) saturate(140%);-webkit-backdrop-filter:blur(10px) saturate(140%);border-bottom:1px solid var(--line);">
  <div class="g-wrap" style="height:60px;display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <div style="display:flex;align-items:center;gap:12px;">
      <label for="gh-toggle-{{ section.id }}" class="gh-burger" aria-label="Menu"><span></span><span></span><span></span></label>
      <a href="{{ routes.root_url }}" class="gh-logo" style="display:flex;align-items:center;text-decoration:none;">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="height:{{ section.settings.logo_height }}px;width:auto;display:block;">
        {%- else -%}
          <img src="{{ 'gene-logo.png' | asset_url }}" alt="{{ section.settings.logo_text | default: shop.name }}" style="height:{{ section.settings.logo_height }}px;width:auto;display:block;">
        {%- endif -%}
      </a>
    </div>
    <nav class="gh-nav" style="display:flex;gap:24px;align-items:center;">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" style="font-size:13px;font-weight:{% if forloop.first %}700{% else %}600{% endif %};letter-spacing:0.02em;text-transform:uppercase;text-decoration:none;{% unless forloop.first %}color:var(--ink-soft);{% endunless %}">{{ link.title }}</a>
      {%- endfor -%}
      {%- if use_cat_menu -%}
        {%- for link in section.settings.category_menu.links -%}
          <a href="{{ link.url }}" style="font-size:13px;font-weight:600;letter-spacing:0.02em;text-transform:uppercase;text-decoration:none;color:var(--ink-soft);">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for label in cat_labels -%}
          <a href="{{ routes.root_url }}collections/{{ cat_handles[forloop.index0] }}" style="font-size:13px;font-weight:600;letter-spacing:0.02em;text-transform:uppercase;text-decoration:none;color:var(--ink-soft);">{{ label }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="gh-actions" style="display:flex;align-items:center;gap:14px;">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" style="font-size:13px;font-weight:500;color:var(--ink-soft);text-decoration:none;">{{ section.settings.login_label }}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" style="display:inline-flex;align-items:center;gap:7px;background:var(--ink);color:#fff;border-radius:999px;padding:8px 15px;font-size:13px;font-weight:600;text-decoration:none;">
        {{ section.settings.cart_label }}
        <span data-cart-count style="min-width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;background:#fff;color:var(--ink);border-radius:999px;font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;padding:0 5px;">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="gh-mobile">
    <nav class="gh-mnav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- if use_cat_menu -%}
        {%- for link in section.settings.category_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}
        {%- for label in cat_labels -%}<a href="{{ routes.root_url }}collections/{{ cat_handles[forloop.index0] }}">{{ label }}</a>{%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="gh-mactions">
      <a href="{{ routes.cart_url }}" class="gh-mact gh-mact--primary">{{ section.settings.cart_label }} <span>({{ cart.item_count }})</span></a>
      <a href="{{ routes.account_url }}" class="gh-mact">{{ section.settings.profile_label }}</a>
    </div>
  </div>
</header>
<style>
  .gh-burger { display:none; }
  .gh-mobile { display:none; }
  .gh-toggle:checked ~ header .gh-mobile { display:block; }
  .gh-mobile { border-top:1px solid var(--line); background:var(--paper); padding:6px 24px 20px; }
  .gh-mnav { display:flex; flex-direction:column; }
  .gh-mnav a { padding:15px 4px; font-weight:700; font-size:16px; text-transform:uppercase; letter-spacing:0.02em; text-decoration:none; color:var(--ink); border-bottom:1px solid var(--line); }
  .gh-mactions { display:flex; gap:10px; margin-top:18px; }
  .gh-mact { flex:1; display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:14px; border-radius:999px; font-weight:700; font-size:14px; text-decoration:none; }
  .gh-mact--primary { background:var(--ink); color:#fff; }
  .gh-mact:not(.gh-mact--primary) { background:#fff; color:var(--ink); border:1.5px solid var(--ink); }
  @media (max-width:900px){
    .gh-nav { display:none !important; }
    .gh-actions { display:none !important; }
    .gh-burger { display:flex; flex-direction:column; justify-content:center; gap:5px; width:26px; height:26px; cursor:pointer; }
    .gh-burger span { display:block; height:2px; width:22px; background:var(--ink); border-radius:2px; transition:transform .22s var(--ease), opacity .18s; }
    .gh-toggle:checked ~ header .gh-burger span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
    .gh-toggle:checked ~ header .gh-burger span:nth-child(2){ opacity:0; }
    .gh-toggle:checked ~ header .gh-burger span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }
  }
  @media (min-width:901px){ .gh-mobile { display:none !important; } }
</style>
{% schema %}
{
  "name": "Hlavička",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (obrázek)" },
    { "type": "range", "id": "logo_height", "label": "Výška loga", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 30 },
    { "type": "text", "id": "logo_text", "label": "Text loga (pokud není obrázek)", "default": "GENE®" },
    { "type": "link_list", "id": "menu", "label": "Hlavní menu", "default": "main-menu" },
    { "type": "link_list", "id": "category_menu", "label": "Menu kategorií (jinak Tees/Hoodies/Bottoms/Shorts)" },
    { "type": "text", "id": "login_label", "label": "Text přihlášení", "default": "Log in" },
    { "type": "text", "id": "cart_label", "label": "Text košíku", "default": "Cart" },
    { "type": "text", "id": "profile_label", "label": "Text profilu (mobil)", "default": "Profil" }
  ]
}
{% endschema %}
