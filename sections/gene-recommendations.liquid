{%- comment -%}
  Karta nesmí být celá odkaz — tlačítko uvnitř <a> by se pořád chovalo jako
  proklik na produkt. Odkazy jsou proto jen na fotce a názvu, quick add stojí
  vedle nich. Modal i jeho obsluha jsou vlastní, protože na stránce produktu
  žádná mřížka není, ze které by se daly převzít.
{%- endcomment -%}
{%- assign coll = product.collections.first -%}
{%- assign pool = coll.products | default: collections.all.products -%}
<section class="g-wrap grec" id="grec-{{ section.id }}" style="padding:40px 24px;">
  <h2 class="grec-title">{{ section.settings.title | default: 'You may also like' }}</h2>
  <div class="grec-grid">
    {%- assign shown = 0 -%}
    {%- for p in pool -%}
      {%- if p.id != product.id and shown < 4 -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="grec-card" data-product>
          <a class="grec-img" href="{{ p.url }}">
            {%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 700 }}" alt="{{ p.title | escape }}" loading="lazy">{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}
            {%- unless p.available -%}<span class="grec-sale grec-sale--out">Sold out</span>{%- else -%}{%- if p.compare_at_price > p.price -%}<span class="grec-sale">Sale</span>{%- endif -%}{%- endunless -%}
          </a>
          <a class="grec-name" href="{{ p.url }}">{{ p.title }}</a>
          <div class="grec-price">
            {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {%- endif -%}{{ p.price | money }}
          </div>
          {%- if p.available -%}
            <button class="grec-add" type="button" data-qa-open>Quick add</button>
            <script type="application/json" class="gg-qa">{"name":{{ p.title | json }},"price":{{ p.price | money | json }},"img":{{ p.featured_media | image_url: width: 320 | json }},"variants":[{%- for v in p.variants -%}{%- if p.has_only_default_variant -%}{%- assign vt = 'One size' -%}{%- else -%}{%- assign vt = v.title -%}{%- endif -%}{"id":{{ v.id }},"title":{{ vt | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
          {%- else -%}
            <button class="grec-add grec-add--out" type="button" disabled>Sold out</button>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<div class="gg-modal" id="grec-modal-{{ section.id }}" hidden>
  <div class="gg-modal__overlay" data-qa-close></div>
  <div class="gg-modal__panel" role="dialog" aria-modal="true" aria-label="Quick add">
    <div class="gg-modal__head">
      <span class="gg-modal__title">Quick add</span>
      <button class="gg-modal__close" type="button" data-qa-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="gg-modal__prod">
      <div class="gg-modal__img"><img data-qa-img src="" alt="" loading="lazy"></div>
      <div class="gg-modal__meta">
        <div class="gg-modal__name" data-qa-name></div>
        <div class="gg-modal__price" data-qa-price></div>
      </div>
    </div>
    <div class="gg-modal__label">Select size</div>
    <div class="gg-modal__sizes" data-qa-sizes></div>
  </div>
</div>

<style>
  #grec-{{ section.id }} .grec-title{ font-weight:800; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.02em; margin:0 0 22px; }
  #grec-{{ section.id }} .grec-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  #grec-{{ section.id }} .grec-card{ display:flex; flex-direction:column; }
  #grec-{{ section.id }} .grec-img{ position:relative; display:block; aspect-ratio:1/1; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:var(--tag); }
  #grec-{{ section.id }} .grec-img img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s var(--ease); }
  #grec-{{ section.id }} .grec-card:hover .grec-img img{ transform:scale(1.03); }
  #grec-{{ section.id }} .grec-sale{ position:absolute; top:10px; left:10px; background:var(--ink); color:#fff; font-size:11px; font-weight:700; padding:4px 11px; border-radius:999px; }
  #grec-{{ section.id }} .grec-sale--out{ background:var(--paper); color:var(--ink); border:1px solid var(--ink); }
  #grec-{{ section.id }} .grec-name{ font-size:14px; margin:12px 0 4px; color:inherit; text-decoration:none; }
  #grec-{{ section.id }} .grec-price{ font-size:14px; font-weight:600; }
  #grec-{{ section.id }} .grec-price s{ color:var(--ink-muted); font-weight:400; }
  #grec-{{ section.id }} .grec-add{ margin-top:12px; width:100%; background:var(--ink); color:#fff; border:none; border-radius:999px; padding:11px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; transition:opacity .15s var(--ease); }
  #grec-{{ section.id }} .grec-add:hover{ opacity:.88; }
  #grec-{{ section.id }} .grec-add--out{ background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); cursor:default; }
  #grec-{{ section.id }} .grec-add--out:hover{ opacity:1; }
  @media (max-width:820px){ #grec-{{ section.id }} .grec-grid{ grid-template-columns:repeat(2,1fr); gap:12px; } }

  /* quick-add size modal */
  #grec-modal-{{ section.id }}.gg-modal { position:fixed; inset:0; z-index:300; display:flex; align-items:center; justify-content:center; }
  #grec-modal-{{ section.id }}.gg-modal[hidden] { display:none; }
  #grec-modal-{{ section.id }} .gg-modal__overlay { position:absolute; inset:0; background:rgba(0,0,0,0.5); }
  #grec-modal-{{ section.id }} .gg-modal__panel { position:relative; z-index:1; width:460px; max-width:calc(100% - 32px); max-height:85vh; overflow-y:auto; background:var(--paper); border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,0.28); }
  #grec-modal-{{ section.id }} .gg-modal__head { position:sticky; top:0; background:var(--paper); display:grid; grid-template-columns:24px 1fr 24px; align-items:center; padding:16px; border-bottom:1px solid var(--line); }
  #grec-modal-{{ section.id }} .gg-modal__title { grid-column:2; text-align:center; font-weight:800; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; }
  #grec-modal-{{ section.id }} .gg-modal__close { grid-column:3; background:none; border:none; padding:0; cursor:pointer; color:var(--ink); display:inline-flex; }
  #grec-modal-{{ section.id }} .gg-modal__close svg { width:22px; height:22px; }
  #grec-modal-{{ section.id }} .gg-modal__prod { display:flex; gap:14px; padding:16px; }
  #grec-modal-{{ section.id }} .gg-modal__img { width:84px; height:100px; flex:none; border-radius:8px; overflow:hidden; background:#EFEFEF; }
  #grec-modal-{{ section.id }} .gg-modal__img img { width:100%; height:100%; object-fit:cover; }
  #grec-modal-{{ section.id }} .gg-modal__meta { display:flex; flex-direction:column; justify-content:center; gap:4px; }
  #grec-modal-{{ section.id }} .gg-modal__name { font-weight:600; font-size:16px; }
  #grec-modal-{{ section.id }} .gg-modal__price { font-weight:700; font-size:15px; }
  #grec-modal-{{ section.id }} .gg-modal__label { padding:6px 16px 4px; font-weight:800; font-size:13px; letter-spacing:0.06em; text-transform:uppercase; }
  #grec-modal-{{ section.id }} .gg-modal__sizes { display:flex; flex-direction:column; padding-bottom:8px; }
  #grec-modal-{{ section.id }} .gg-msize { display:flex; align-items:center; justify-content:space-between; width:100%; padding:17px 16px; background:none; border:none; border-top:1px solid var(--line); font:inherit; font-weight:700; font-size:15px; text-align:left; color:var(--ink); cursor:pointer; }
  #grec-modal-{{ section.id }} .gg-msize:hover:not(.is-out) { background:rgba(0,0,0,0.05); }
  #grec-modal-{{ section.id }} .gg-msize.is-out { color:var(--ink-muted); cursor:default; }
  #grec-modal-{{ section.id }} .gg-msize__oos { font-weight:700; font-size:14px; color:var(--ink-muted); }
  #grec-modal-{{ section.id }} .gg-msize.is-loading { opacity:0.5; }
  @media (max-width:600px){
    #grec-modal-{{ section.id }}.gg-modal { align-items:flex-end; }
    #grec-modal-{{ section.id }} .gg-modal__panel { width:100%; max-width:100%; max-height:88vh; border-radius:18px 18px 0 0; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('grec-{{ section.id }}');
  var modal = document.getElementById('grec-modal-{{ section.id }}');
  if (!root || !modal || root.dataset.init) return;
  root.dataset.init = '1';
  var qaSizes = modal.querySelector('[data-qa-sizes]');

  function bumpCount() {
    fetch('{{ routes.cart_url }}.js').then(function (r) { return r.json(); }).then(function (c) {
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = c.item_count;
        el.classList.remove('is-empty');
      });
    });
  }
  function add(id) {
    return fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: Number(id), quantity: 1 })
    }).then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); });
  }
  function openModal(card) {
    var dataEl = card && card.querySelector('.gg-qa');
    if (!dataEl) return;
    var d; try { d = JSON.parse(dataEl.textContent); } catch (e) { return; }
    var img = modal.querySelector('[data-qa-img]');
    if (img) { if (d.img) { img.src = d.img; img.style.display = ''; } else { img.style.display = 'none'; } }
    modal.querySelector('[data-qa-name]').textContent = d.name || '';
    modal.querySelector('[data-qa-price]').textContent = d.price || '';
    qaSizes.innerHTML = (d.variants || []).map(function (v) {
      if (v.available) {
        return '<button type="button" class="gg-msize" data-qa-size data-variant-id="' + v.id + '"><span>' + v.title + '</span></button>';
      }
      return '<div class="gg-msize is-out"><span>' + v.title + '</span><span class="gg-msize__oos">Out of stock</span></div>';
    }).join('');
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() { modal.hidden = true; document.body.style.overflow = ''; }

  root.addEventListener('click', function (e) {
    var openBtn = e.target.closest('[data-qa-open]');
    if (openBtn) { openModal(openBtn.closest('[data-product]')); }
  });
  modal.addEventListener('click', function (e) {
    if (e.target.closest('[data-qa-close]')) { closeModal(); return; }
    var sizeRow = e.target.closest('[data-qa-size]');
    if (!sizeRow || sizeRow.classList.contains('is-loading')) return;
    sizeRow.classList.add('is-loading');
    add(sizeRow.dataset.variantId).then(function () { bumpCount(); closeModal(); })
      .catch(function () { sizeRow.classList.remove('is-loading'); });
  });
  document.addEventListener('keydown', function (e) { if (!modal.hidden && e.key === 'Escape') closeModal(); });
})();
</script>
{% schema %}
{
  "name": "GENE — Doporučené",
  "settings": [ { "type": "text", "id": "title", "label": "Nadpis", "default": "You may also like" } ],
  "presets": [ { "name": "GENE — Doporučené" } ]
}
{% endschema %}
