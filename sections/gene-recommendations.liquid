{%- comment -%}
  Karta nesmí být celá odkaz — tlačítko uvnitř <a> by se pořád chovalo jako
  proklik na produkt. Odkazy jsou proto jen na fotce, názvu a tlačítku
  Preview; ikona košíku stojí vedle nich a otevírá sdílený panel z
  snippets/gene-quick-add.liquid.
{%- endcomment -%}
{%- assign coll = product.collections.first -%}
{%- assign pool = coll.products | default: collections.all.products -%}
<section class="g-wrap grec" id="grec-{{ section.id }}" style="padding:40px 24px;">
  <h2 class="grec-title">{{ section.settings.title | default: 'You may also like' }}</h2>
  <div class="grec-grid">
    {%- assign shown = 0 -%}
    {%- for p in pool -%}
      {%- if p.id != product.id and shown < 4 -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="grec-card" data-product>
          <div class="grec-mediawrap">
            <a class="grec-img" href="{{ p.url }}">
              {%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 700 }}" alt="{{ p.title | escape }}" loading="lazy">{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}
              {%- unless p.available -%}<span class="grec-sale grec-sale--out">Sold out</span>{%- else -%}{%- if p.compare_at_price > p.price -%}<span class="grec-sale">Sale</span>{%- endif -%}{%- endunless -%}
            </a>
            {%- if p.available -%}
              <button class="grec-qa" type="button" data-qa-open aria-label="Přidat {{ p.title | escape }} do košíku">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 8.5h11v10a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5v-10Z"/><path d="M7.5 8.5V6.5a2.5 2.5 0 0 1 5 0v2"/><path d="M19 3.5v5M16.5 6h5"/></svg>
              </button>
            {%- endif -%}
          </div>
          <a class="grec-name" href="{{ p.url }}">{{ p.title }}</a>
          <div class="grec-price">
            {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {%- endif -%}{{ p.price | money }}
          </div>
          {%- if p.available -%}
            <a class="grec-add" href="{{ p.url }}">View product</a>
            <script type="application/json" class="gg-qa">{"name":{{ p.title | json }},"price":{{ p.price | money | json }},"compare":{% if p.compare_at_price > p.price %}{{ p.compare_at_price | money | json }}{% else %}null{% endif %},"img":{{ p.featured_media | image_url: width: 320 | json }},"url":{{ p.url | json }},"singleVariant":{{ p.has_only_default_variant }},"options":[{%- for o in p.options_with_values -%}{"name":{{ o.name | json }},"values":{{ o.values | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"variants":[{%- for v in p.variants -%}{"id":{{ v.id }},"opts":{{ v.options | json }},"available":{{ v.available }},"img":{% if v.featured_media %}{{ v.featured_media | image_url: width: 400 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
          {%- else -%}
            <button class="grec-add grec-add--out" type="button" disabled>Sold out</button>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>


<style>
  #grec-{{ section.id }} .grec-title{ font-weight:800; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.02em; margin:0 0 22px; }
  #grec-{{ section.id }} .grec-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  #grec-{{ section.id }} .grec-card{ display:flex; flex-direction:column; height:100%; }
  #grec-{{ section.id }} .grec-img{ position:relative; display:block; aspect-ratio:1/1; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:var(--tag); }
  #grec-{{ section.id }} .grec-img img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s var(--ease); }
  #grec-{{ section.id }} .grec-card:hover .grec-img img{ transform:scale(1.03); }
  #grec-{{ section.id }} .grec-sale{ position:absolute; top:10px; left:10px; background:var(--ink); color:#fff; font-size:11px; font-weight:700; padding:4px 11px; border-radius:999px; }
  #grec-{{ section.id }} .grec-sale--out{ background:var(--paper); color:var(--ink); border:1px solid var(--ink); }
  #grec-{{ section.id }} .grec-mediawrap{ position:relative; }
  #grec-{{ section.id }} .grec-qa{ position:absolute; right:10px; bottom:10px; z-index:2; width:40px; height:40px; padding:0; display:inline-flex; align-items:center; justify-content:center; border:none; border-radius:50%; background:rgba(227,226,222,.94); color:var(--ink); box-shadow:0 2px 10px rgba(0,0,0,.16); cursor:pointer; transition:transform .2s var(--ease), background .2s var(--ease); }
  #grec-{{ section.id }} .grec-qa svg{ width:20px; height:20px; display:block; }
  #grec-{{ section.id }} .grec-qa:hover{ transform:scale(1.08); background:#fff; }
  @media (max-width:640px){
    #grec-{{ section.id }} .grec-qa{ width:34px; height:34px; right:7px; bottom:7px; }
    #grec-{{ section.id }} .grec-qa svg{ width:17px; height:17px; }
  }
  #grec-{{ section.id }} .grec-name{ font-size:14px; margin:12px 0 4px; color:inherit; text-decoration:none; }
  #grec-{{ section.id }} .grec-price{ font-size:14px; font-weight:600; margin-bottom:auto; }
  #grec-{{ section.id }} .grec-price s{ color:var(--ink-muted); font-weight:400; }
  #grec-{{ section.id }} .grec-add{ margin-top:12px; align-self:stretch; width:100%; box-sizing:border-box; text-align:center; text-decoration:none; background:var(--ink); color:#fff; border:none; border-radius:999px; padding:11px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; transition:opacity .15s var(--ease); }
  #grec-{{ section.id }} .grec-add:hover{ opacity:.88; }
  #grec-{{ section.id }} .grec-add--out{ background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); cursor:default; }
  #grec-{{ section.id }} .grec-add--out:hover{ opacity:1; }
  @media (max-width:820px){ #grec-{{ section.id }} .grec-grid{ grid-template-columns:repeat(2,1fr); gap:12px; } }

</style>

{% schema %}
{
  "name": "GENE — Doporučené",
  "settings": [ { "type": "text", "id": "title", "label": "Nadpis", "default": "You may also like" } ],
  "presets": [ { "name": "GENE — Doporučené" } ]
}
{% endschema %}
