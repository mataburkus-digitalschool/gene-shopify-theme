<section class="g-wrap" style="padding:56px 24px 8px;">
  <div style="margin-bottom:24px;">
    {%- if section.settings.eyebrow != blank -%}<div class="g-eyebrow" style="margin-bottom:8px;">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2 class="g-h2">{{ section.settings.title }}</h2>
  </div>
  <div class="gbun-grid">
    {%- for block in section.blocks -%}
    {%- liquid
      assign p1 = block.settings.product1
      assign p2 = block.settings.product2
      assign is_set = false
      if p1 != blank and p2 != blank
        assign is_set = true
      endif
      assign regular = p1.price | plus: p2.price
      assign keep = 100 | minus: block.settings.discount
      assign bprice = regular | times: keep | divided_by: 100
      assign save = regular | minus: bprice
      assign cur = p1.selected_or_first_available_variant
      assign img = block.settings.image | default: p1.featured_media
    -%}
    <div {{ block.shopify_attributes }} style="border:1.5px solid var(--ink);border-radius:6px;overflow:hidden;background:#fff;display:flex;flex-direction:column;">
      <div style="position:relative;aspect-ratio:16/10;background:var(--tag);overflow:hidden;">
        {%- if img -%}<img src="{{ img | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}{{ 'product-apparel-2' | placeholder_svg_tag }}{%- endif -%}
        {%- if is_set -%}<span style="position:absolute;top:10px;left:10px;background:var(--ink);color:#fff;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:0.1em;padding:4px 8px;border-radius:4px;">SAVE {{ save | money }}</span>{%- endif -%}
      </div>
      <div style="padding:16px 16px 18px;display:flex;flex-direction:column;gap:10px;flex:1;">
        <div style="font-family:var(--mono);font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);">{{ block.settings.tag }}</div>
        <div style="font-weight:700;font-size:18px;line-height:1.2;">{{ block.settings.title }}</div>
        <div style="font-size:13px;color:var(--ink-soft);line-height:1.45;">{% if is_set %}{{ p1.title }} + {{ p2.title }}{% elsif p1 != blank %}{{ p1.title }}{% endif %}</div>

        {%- if is_set -%}
          {%- comment -%} TWO PRODUCTS → set, no size {%- endcomment -%}
          <div style="display:flex;align-items:baseline;gap:8px;font-variant-numeric:tabular-nums;margin-top:auto;">
            <span style="font-weight:800;font-size:20px;">{{ bprice | money }}</span>
            <s style="font-size:14px;color:var(--ink-muted);">{{ regular | money }}</s>
          </div>
          <button type="button" class="g-btn gbun-add" style="width:100%;padding:12px;font-size:14px;"
            data-v1="{{ p1.selected_or_first_available_variant.id }}" data-v2="{{ p2.selected_or_first_available_variant.id }}"
            {% unless p1.available and p2.available %}disabled{% endunless %}>
            Add set — {{ bprice | money }}
          </button>

        {%- elsif p1 != blank -%}
          {%- comment -%} ONE PRODUCT → size picker, add single {%- endcomment -%}
          <div style="display:flex;align-items:baseline;gap:8px;font-variant-numeric:tabular-nums;margin-top:auto;">
            <span class="gbun-price" style="font-weight:800;font-size:20px;">{{ cur.price | money }}</span>
            {%- if cur.compare_at_price > cur.price -%}<s style="font-size:14px;color:var(--ink-muted);">{{ cur.compare_at_price | money }}</s>{%- endif -%}
          </div>

          {%- if p1.variants.size > 1 -%}
            <div class="gbun-sizes" style="display:flex;flex-wrap:wrap;gap:7px;">
              {%- for v in p1.variants -%}
                <button type="button" class="gbun-size{% if v.id == cur.id %} is-active{% endif %}"
                  data-variant="{{ v.id }}" data-price="{{ v.price | money }}"
                  {% unless v.available %}data-out disabled{% endunless %}>{{ v.title }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <button type="button" class="g-btn gbun-add" style="width:100%;padding:12px;font-size:14px;"
            data-single data-v1="{{ cur.id }}"
            {% unless p1.available %}disabled{% endunless %}>
            {% if p1.available %}Add to cart — {{ cur.price | money }}{% else %}Sold out{% endif %}
          </button>
        {%- endif -%}
      </div>
    </div>
    {%- endfor -%}
  </div>
</section>
<style>
.gbun-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
@media (max-width:900px){ .gbun-grid{ grid-template-columns:1fr; } }
.gbun-size { font-family:var(--mono); font-size:12px; min-width:40px; padding:8px 12px; background:#fff; color:var(--ink); border:1.5px solid var(--line); border-radius:999px; cursor:pointer; transition:all .15s var(--ease); }
.gbun-size:hover { border-color:var(--ink); }
.gbun-size.is-active { background:var(--ink); color:#fff; border-color:var(--ink); }
.gbun-size[data-out] { opacity:.35; text-decoration:line-through; cursor:not-allowed; }
</style>
<script>
(function(){
  // size picker → update selected variant + price on the card
  document.querySelectorAll('.gbun-sizes').forEach(function(row){
    if (row.dataset.init) return; row.dataset.init = '1';
    var card = row.closest('div[style*="flex-direction:column"]') || row.parentNode;
    row.addEventListener('click', function(e){
      var b = e.target.closest('.gbun-size'); if(!b || b.hasAttribute('data-out')) return;
      row.querySelectorAll('.gbun-size').forEach(function(s){ s.classList.remove('is-active'); });
      b.classList.add('is-active');
      var add = card.querySelector('.gbun-add');
      var price = b.getAttribute('data-price');
      if (add){ add.setAttribute('data-v1', b.getAttribute('data-variant')); add.textContent = 'Add to cart — ' + price; add.dataset.label = add.textContent; }
      var priceEl = card.querySelector('.gbun-price'); if (priceEl) priceEl.textContent = price;
    });
  });

  document.querySelectorAll('.gbun-add').forEach(function(btn){
    if (btn.dataset.init) return; btn.dataset.init = '1'; btn.dataset.label = btn.textContent.trim();
    btn.addEventListener('click', function(){
      var orig = btn.dataset.label; btn.disabled = true; btn.textContent = '…';
      var items = [ { id:Number(btn.dataset.v1), quantity:1 } ];
      if (btn.dataset.v2) items.push({ id:Number(btn.dataset.v2), quantity:1 });
      fetch('{{ routes.cart_add_url }}.js', {
        method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ items:items })
      }).then(function(r){ if(!r.ok) throw 0;
        btn.textContent = '✓ Přidáno';
        fetch('{{ routes.cart_url }}.js').then(function(r){return r.json();}).then(function(c){
          document.querySelectorAll('[data-cart-count]').forEach(function(el){ el.textContent = c.item_count; });
        });
        setTimeout(function(){ btn.textContent = orig; btn.disabled = false; }, 1600);
      }).catch(function(){ btn.textContent = orig; btn.disabled = false; });
    });
  });
})();
</script>
{% schema %}
{
  "name": "GENE — Bundles",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buy the set · save more" },
    { "type": "text", "id": "title", "label": "Titulek", "default": "Bundles & Sets" }
  ],
  "blocks": [
    { "type": "bundle", "name": "Bundle", "settings": [
      { "type": "text", "id": "tag", "label": "Označení", "default": "2-Piece Set" },
      { "type": "text", "id": "title", "label": "Název", "default": "Head-to-Toe Set" },
      { "type": "product", "id": "product1", "label": "Produkt 1" },
      { "type": "product", "id": "product2", "label": "Produkt 2 (necháš prázdné = jeden produkt s výběrem velikosti)" },
      { "type": "range", "id": "discount", "label": "Sleva setu (%)", "min": 0, "max": 50, "step": 5, "default": 15 },
      { "type": "image_picker", "id": "image", "label": "Vlastní obrázek" }
    ] }
  ],
  "presets": [ { "name": "GENE — Bundles", "blocks": [ { "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" } ] } ]
}
{% endschema %}
