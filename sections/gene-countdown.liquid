<section style="background:var(--ink);color:#fff;">
  <div class="g-wrap" style="padding:22px 24px;display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;text-align:center;">
    <div style="font-weight:800;font-size:clamp(20px,2.6vw,28px);letter-spacing:-0.01em;">{{ section.settings.heading_prefix }} <span style="text-decoration:underline;text-underline-offset:4px;">{{ section.settings.heading_underline }}</span></div>
    <div id="gcd-{{ section.id }}" style="display:flex;gap:8px;font-variant-numeric:tabular-nums;">
      {%- assign units = 'Hrs,Min,Sec' | split: ',' -%}
      {%- for u in units -%}
      <div style="background:#fff;color:var(--ink);border-radius:6px;padding:8px 12px;min-width:58px;">
        <div data-u="{{ forloop.index0 }}" style="font-weight:800;font-size:24px;line-height:1;">00</div>
        <div style="font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-muted);margin-top:3px;">{{ u }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function(){
  var el = document.getElementById('gcd-{{ section.id }}');
  if (!el) return;
  var cells = el.querySelectorAll('[data-u]');
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var now = new Date(); var end = new Date(now); end.setHours(24,0,0,0);
    var d = Math.max(0, end - now);
    var h = Math.floor(d/3600000); d -= h*3600000;
    var m = Math.floor(d/60000); d -= m*60000;
    var s = Math.floor(d/1000);
    cells[0].textContent = pad(h); cells[1].textContent = pad(m); cells[2].textContent = pad(s);
  }
  tick(); setInterval(tick, 1000);
})();
</script>
{% schema %}
{
  "name": "GENE — Odpočet slevy",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading_prefix", "label": "Titulek", "default": "SUMMER ARCHIVE —" },
    { "type": "text", "id": "heading_underline", "label": "Podtržená část", "default": "SALE DIES AT MIDNIGHT" }
  ],
  "presets": [ { "name": "GENE — Odpočet slevy" } ]
}
{% endschema %}