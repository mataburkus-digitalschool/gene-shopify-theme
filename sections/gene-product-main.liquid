{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign th = section.settings.low_stock | default: 10 -%}
<section class="gpm g-wrap" id="gpm-{{ section.id }}" data-gpm>
  <div class="gpm-grid">
    {%- comment -%} ── MEDIA ── {%- endcomment -%}
    {%- comment -%}
      Fotky jedou v jednom posuvném pásu — vidět je vždycky jen jedna, mezi
      nimi se přejíždí prstem nebo šipkami. Žádná mřížka náhledů, která by
      vysypala všechny fotky najednou.
    {%- endcomment -%}
    <div class="gpm-media">
      <div class="gpm-slider" data-slider>
        <div class="gpm-track" data-track tabindex="0" role="group" aria-label="{{ product.title | escape }} — fotky">
          {%- if product.media.size > 0 -%}
            {%- for m in product.media -%}
              <div class="gpm-slide" data-slide data-media-id="{{ m.id }}">
                <img src="{{ m | image_url: width: 1100 }}" alt="{{ product.title | escape }}"
                     {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="gpm-slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <button type="button" class="gpm-nav gpm-nav--prev" data-prev aria-label="Předchozí fotka">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="gpm-nav gpm-nav--next" data-next aria-label="Další fotka">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
          <div class="gpm-dots" data-dots>
            {%- for m in product.media -%}
              <button type="button" class="gpm-dot{% if forloop.first %} on{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Fotka {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── INFO ── {%- endcomment -%}
    <div class="gpm-info">
      {%- if product.vendor != blank -%}<div class="gpm-eyebrow">{{ product.vendor }}</div>{%- endif -%}
      <h1 class="gpm-title">{{ product.title }}</h1>

      <div class="gpm-price">
        {%- if cur.compare_at_price > cur.price -%}<s class="gpm-was" data-was>{{ cur.compare_at_price | money }}</s>{%- endif -%}
        <span class="gpm-now" data-now>{{ cur.price | money }}</span>
        <span class="gpm-sale" data-sale{% unless cur.compare_at_price > cur.price %} hidden{% endunless %}>Sale</span>
      </div>
      <div class="gpm-tax">Taxes included. <a href="{{ pages['shipping-policy'].url | default: routes.root_url }}">Shipping</a> calculated at checkout.</div>

      {%- if section.settings.show_urgency -%}
      <div class="gpm-stock" data-stock {% unless cur.inventory_management and cur.inventory_quantity > 0 and cur.inventory_quantity <= th %}hidden{% endunless %}>
        ⚠️ Only <span data-stock-n>{{ cur.inventory_quantity }}</span> left in stock!
      </div>
      {%- endif -%}
      {%- if section.settings.limited_text != blank -%}<div class="gpm-limited">{{ section.settings.limited_text }}</div>{%- endif -%}

      {% form 'product', product, id: 'gpm-form' %}
        <input type="hidden" name="id" value="{{ cur.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for opt in product.options_with_values -%}
          <div class="gpm-opt" data-opt-index="{{ forloop.index0 }}">
            <div class="gpm-opt-label">{{ opt.name }}</div>
            <div class="gpm-opt-vals">
              {%- for val in opt.values -%}
              <button type="button" class="gpm-val{% if opt.selected_value == val %} on{% endif %}" data-value="{{ val | escape }}">{{ val }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="gpm-qty-label">Quantity</div>
        {%- comment -%} množství a Add to cart drží jednu řadu, platba je pod nimi {%- endcomment -%}
        <div class="gpm-buy">
          <div class="gpm-qty">
            <button type="button" data-qty="-" aria-label="Méně">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input>
            <button type="button" data-qty="+" aria-label="Více">+</button>
          </div>

          <button type="submit" class="g-btn g-btn--outline gpm-atc" data-atc {% unless cur.available %}disabled{% endunless %}>
            <span data-atc-label>{% if cur.available %}{{ section.settings.atc_label | default: 'Add to cart' }}{% else %}Sold out{% endif %}</span>
          </button>
        </div>

        {{ form | payment_button }}
      {% endform %}

      <div class="gpm-trust">♻ 14 days easy returns &nbsp;·&nbsp; ✔ World-class customer support</div>

      {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="gpm-pay">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'gpm-pay-i' }}{%- endfor -%}
      </div>
      {%- endif -%}

      {%- comment -%} ── ACCORDIONS ── {%- endcomment -%}
      <div class="gpm-acc">
        {%- if product.description != blank -%}
        <div class="gpm-desc">{{ product.description }}</div>
        {%- endif -%}
        {%- assign accs = 'Shipping information|acc_shipping,14 days easy returns|acc_returns,Size|acc_size' | split: ',' -%}
        {%- for a in accs -%}
          {%- assign parts = a | split: '|' -%}
          {%- assign key = parts[1] | strip -%}
          {%- assign body = section.settings[key] -%}
          {%- if body != blank -%}
          <details class="gpm-det">
            <summary>{{ parts[0] }}<span class="gpm-chev">⌄</span></summary>
            <div class="gpm-det-body">{{ body }}</div>
          </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ── STICKY BAR ── {%- endcomment -%}
  {%- comment -%}
    Lišta visí u spodní hrany po celou dobu, ne až když odscrolluješ pod
    tlačítko. Aby nikdy nepřekryla obsah, rezervuje si místo padding na body
    níž ve stylech — ten se vypisuje jen na stránce produktu.
  {%- endcomment -%}
  <div class="gpm-sticky" data-sticky>
    <div class="gpm-sticky-in g-wrap">
      <div class="gpm-sticky-info">
        <strong>{{ product.title }}</strong>
        <span data-sticky-price>{{ cur.price | money }}</span>
      </div>
      <button type="button" class="g-btn gpm-sticky-btn" data-sticky-atc>{{ section.settings.atc_label | default: 'Add to cart' }}</button>
    </div>
  </div>

  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"opts":{{ v.options | json }},"available":{{ v.available }},"inv":{{ v.inventory_quantity | default: 9999 }},"tracked":{% if v.inventory_management %}true{% else %}false{% endif %},"price":{{ v.price | json }},"priceM":{{ v.price | money | json }},"compareM":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"mediaId":{% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</section>

<style>
.gpm{ padding:40px 24px 20px; }
.gpm-grid{ display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px; align-items:start; }
/* galerie — čtverec, ostré rohy */
.gpm-slider{ position:relative; border:1px solid var(--line); background:var(--tag); }
.gpm-track{ display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; scrollbar-width:none; -ms-overflow-style:none; outline:none; }
.gpm-track::-webkit-scrollbar{ display:none; }
.gpm-slide{ flex:0 0 100%; scroll-snap-align:center; aspect-ratio:1/1; }
.gpm-slide img,.gpm-slide svg{ width:100%; height:100%; object-fit:{{ section.settings.image_fit | default: 'contain' }}; display:block; }
.gpm-nav{ position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:50%; background:rgba(255,255,255,.86); backdrop-filter:blur(6px); color:var(--ink); cursor:pointer; padding:0; transition:opacity .18s var(--ease); }
.gpm-nav svg{ width:20px; height:20px; }
.gpm-nav--prev{ left:10px; }
.gpm-nav--next{ right:10px; }
.gpm-nav:hover{ background:#fff; }
.gpm-nav[disabled]{ opacity:.3; cursor:default; }
.gpm-dots{ position:absolute; left:0; right:0; bottom:12px; display:flex; justify-content:center; gap:7px; }
.gpm-dot{ width:7px; height:7px; padding:0; border:none; border-radius:50%; background:rgba(26,26,26,.28); cursor:pointer; transition:background .18s var(--ease), transform .18s var(--ease); }
.gpm-dot.on{ background:var(--ink); transform:scale(1.25); }
.gpm-eyebrow{ font-family:var(--mono); font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:8px; }
.gpm-title{ font-weight:800; font-size:clamp(26px,3vw,38px); letter-spacing:-0.02em; line-height:1.05; margin:0 0 14px; text-transform:uppercase; }
.gpm-price{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px; }
.gpm-was{ color:var(--ink-muted); font-size:16px; }
.gpm-now{ font-weight:700; font-size:22px; }
.gpm-sale{ background:var(--ink); color:#fff; font-size:12px; font-weight:700; padding:3px 11px; border-radius:999px; }
.gpm-sale[hidden]{ display:none; }
.gpm-tax{ font-size:13px; color:var(--ink-soft); margin-bottom:16px; }
.gpm-tax a{ color:var(--ink); }
.gpm-stock{ color:#c0392b; font-weight:700; font-size:15px; margin-bottom:8px; }
.gpm-stock[hidden]{ display:none; }
.gpm-limited{ font-weight:800; font-size:14px; letter-spacing:.01em; text-transform:uppercase; margin-bottom:22px; }
.gpm-opt{ margin-bottom:18px; }
.gpm-opt-label{ font-size:14px; font-weight:600; margin-bottom:9px; }
.gpm-opt-vals{ display:flex; gap:9px; flex-wrap:wrap; }
/* Barvu textu si tlačítka a inputy musí říct samy — iOS Safari jim jinak
   dá systémovou modrou, i když na desktopu vyjdou černě. */
.gpm-val{ min-width:52px; padding:11px 18px; border:1.5px solid var(--line); border-radius:999px; background:var(--paper); color:var(--ink); font:inherit; font-size:14px; cursor:pointer; transition:.15s; }
.gpm-val:hover{ border-color:var(--ink); }
.gpm-val.on{ background:var(--ink); color:#fff; border-color:var(--ink); }
.gpm-qty-label{ font-size:14px; font-weight:600; margin:4px 0 9px; }
.gpm-buy{ display:flex; align-items:stretch; gap:10px; margin-bottom:12px; }
.gpm-qty{ display:inline-flex; align-items:center; flex:none; border:1.5px solid var(--ink); border-radius:999px; overflow:hidden; }
.gpm-qty button{ width:42px; height:44px; border:none; background:var(--paper); color:var(--ink); font-size:19px; cursor:pointer; }
.gpm-qty input{ width:46px; height:44px; border:none; text-align:center; font:inherit; font-size:15px; -moz-appearance:textfield; background:var(--paper); color:var(--ink); }
.gpm-qty input::-webkit-outer-spin-button,.gpm-qty input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
.gpm-atc{ flex:1; min-width:0; }
#gpm-form .shopify-payment-button{ margin-bottom:6px; }
#gpm-form .shopify-payment-button__button{ border-radius:999px !important; }
#gpm-form .shopify-payment-button__more-options{ border-radius:999px !important; color:var(--ink) !important; }
.gpm-trust{ text-align:center; font-size:13px; color:var(--ink-soft); margin:14px 0 12px; }
.gpm-pay{ display:flex; gap:7px; justify-content:center; flex-wrap:wrap; margin-bottom:8px; }
.gpm-pay .gpm-pay-i{ width:38px; height:24px; }
.gpm-acc{ margin-top:26px; border-top:1px solid var(--line); }
.gpm-desc{ font-size:15px; line-height:1.65; color:var(--ink-soft); padding:18px 0; border-bottom:1px solid var(--line); }
.gpm-det{ border-bottom:1px solid var(--line); }
.gpm-det summary{ list-style:none; cursor:pointer; padding:16px 2px; font-weight:600; font-size:14px; display:flex; align-items:center; justify-content:space-between; }
.gpm-det summary::-webkit-details-marker{ display:none; }
.gpm-chev{ transition:transform .2s; }
.gpm-det[open] .gpm-chev{ transform:rotate(180deg); }
.gpm-det-body{ padding:0 2px 18px; font-size:14px; line-height:1.6; color:var(--ink-soft); }
/* sticky */
body{ padding-bottom:78px; }
.gpm-sticky{ position:fixed; left:0; right:0; bottom:0; z-index:60; background:var(--paper); border-top:1px solid var(--line); box-shadow:0 -6px 24px rgba(0,0,0,.08); padding-bottom:env(safe-area-inset-bottom); }
.gpm-sticky-in{ display:flex; align-items:center; gap:16px; padding:12px 24px; }
.gpm-sticky-info{ display:flex; flex-direction:column; line-height:1.2; font-size:13px; overflow:hidden; }
.gpm-sticky-info strong{ font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.gpm-sticky-btn{ margin-left:auto; white-space:nowrap; }
@media (max-width:820px){
  .gpm-grid{ grid-template-columns:1fr; gap:22px; }
  .gpm{ padding:24px 20px 90px; }
}
</style>

<script>
(function(){
  var root = document.getElementById('gpm-{{ section.id }}');
  if(!root) return;
  var data = JSON.parse(root.querySelector('[data-variants]').textContent);
  var idInput = root.querySelector('[data-variant-id]');
  var track = root.querySelector('[data-track]');
  var opts = Array.prototype.map.call(root.querySelectorAll('.gpm-opt'), function(o){ return o; });
  var th = {{ th }};

  function selectedOptions(){
    return opts.map(function(o){ var b=o.querySelector('.gpm-val.on'); return b?b.getAttribute('data-value'):null; });
  }
  function findVariant(){
    if(!opts.length) return data[0];
    var sel = selectedOptions();
    return data.find(function(v){ return v.opts.every(function(val,i){ return val===sel[i]; }); });
  }
  function money(v){ return v.priceM; }
  function render(){
    var v = findVariant();
    if(!v) return;
    idInput.value = v.id;
    var now = root.querySelector('[data-now]'); if(now) now.textContent = v.priceM;
    var was = root.querySelector('[data-was]'); var sale = root.querySelector('[data-sale]');
    var priceWrap = root.querySelector('.gpm-price');
    if(v.compareM){
      if(!was){ was=document.createElement('s'); was.className='gpm-was'; was.setAttribute('data-was',''); priceWrap.insertBefore(was, priceWrap.firstChild); }
      was.textContent=v.compareM; was.hidden=false; if(sale) sale.hidden=false;
    } else { if(was) was.hidden=true; if(sale) sale.hidden=true; }
    // stock
    var stock = root.querySelector('[data-stock]');
    if(stock){
      if(v.tracked && v.inv>0 && v.inv<=th){ stock.hidden=false; var n=stock.querySelector('[data-stock-n]'); if(n) n.textContent=v.inv; }
      else stock.hidden=true;
    }
    // atc
    var atc = root.querySelector('[data-atc]'); var lbl = root.querySelector('[data-atc-label]');
    atc.disabled = !v.available; if(lbl) lbl.textContent = v.available ? ({{ section.settings.atc_label | default: 'Add to cart' | json }}) : 'Sold out';
    // sticky price
    var sp = root.querySelector('[data-sticky-price]'); if(sp) sp.textContent=v.priceM;
    // media — u varianty s vlastní fotkou přejedeme na její snímek
    if(v.mediaId){
      var slide = root.querySelector('[data-media-id="'+v.mediaId+'"]');
      if(slide && track){ track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior:'smooth' }); }
    }
  }

  root.querySelectorAll('.gpm-opt-vals').forEach(function(group){
    group.addEventListener('click', function(e){
      var b = e.target.closest('.gpm-val'); if(!b) return;
      group.querySelectorAll('.gpm-val').forEach(function(x){ x.classList.remove('on'); });
      b.classList.add('on'); render();
    });
  });

  // qty
  var qi = root.querySelector('[data-qty-input]');
  root.querySelectorAll('[data-qty]').forEach(function(btn){
    btn.addEventListener('click', function(){ var n=parseInt(qi.value,10)||1; n += (btn.getAttribute('data-qty')==='+'?1:-1); if(n<1)n=1; qi.value=n; });
  });

  // galerie — šipky, tečky, klávesnice; pozice se čte ze scrollu,
  // takže přejetí prstem drží tečky i šipky v souladu bez extra logiky
  if(track){
    var slides = Array.prototype.slice.call(track.querySelectorAll('[data-slide]'));
    var dots   = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
    var prev   = root.querySelector('[data-prev]');
    var next   = root.querySelector('[data-next]');

    function current(){
      var pos = track.scrollLeft, best = 0, min = Infinity;
      slides.forEach(function(s, i){
        var d = Math.abs(s.offsetLeft - track.offsetLeft - pos);
        if(d < min){ min = d; best = i; }
      });
      return best;
    }
    function goTo(i){
      if(i < 0 || i >= slides.length) return;
      track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior:'smooth' });
    }
    function sync(){
      var i = current();
      dots.forEach(function(d, di){ d.classList.toggle('on', di === i); });
      if(prev) prev.disabled = i === 0;
      if(next) next.disabled = i === slides.length - 1;
    }

    if(prev) prev.addEventListener('click', function(){ goTo(current() - 1); });
    if(next) next.addEventListener('click', function(){ goTo(current() + 1); });
    dots.forEach(function(d){
      d.addEventListener('click', function(){ goTo(parseInt(d.getAttribute('data-dot'), 10)); });
    });
    track.addEventListener('keydown', function(e){
      if(e.key === 'ArrowRight'){ e.preventDefault(); goTo(current() + 1); }
      if(e.key === 'ArrowLeft'){ e.preventDefault(); goTo(current() - 1); }
    });

    var tick;
    track.addEventListener('scroll', function(){
      clearTimeout(tick); tick = setTimeout(sync, 60);
    }, { passive:true });
    sync();
  }

  // sticky add-to-cart — lišta je vidět pořád, jen odesílá formulář
  var form = root.querySelector('#gpm-form');
  var sBtn = root.querySelector('[data-sticky-atc]');
  if(sBtn && form){ sBtn.addEventListener('click', function(){ if(typeof form.requestSubmit==='function') form.requestSubmit(); else form.submit(); }); }

  render();
})();
</script>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "checkbox", "id": "show_urgency", "label": "Ukázat „Only X left in stock!“", "default": true },
    { "type": "number", "id": "low_stock", "label": "Práh „posledních kusů“", "default": 10 },
    { "type": "text", "id": "limited_text", "label": "Text pod cenou (urgence)", "default": "LIMITED STOCK. NEVER RESTOCKING!" },
    { "type": "text", "id": "atc_label", "label": "Text tlačítka Add to cart", "default": "Add to cart" },
    { "type": "select", "id": "image_fit", "label": "Fotky ve čtverci", "info": "„Vejít se“ ukáže celou fotku, „Vyplnit“ ji ořízne na čtverec.", "options": [ { "value": "contain", "label": "Vejít se (bez ořezu)" }, { "value": "cover", "label": "Vyplnit (ořízne)" } ], "default": "contain" },
    { "type": "richtext", "id": "acc_shipping", "label": "Akordeon - Shipping information", "default": "<p>Free shipping over $75. Orders ship in 1-2 business days, delivery 5-10 days worldwide with tracking.</p>" },
    { "type": "richtext", "id": "acc_returns", "label": "Akordeon - 14 days easy returns", "default": "<p>Not feeling it? Return within 14 days for a refund or exchange. No drama.</p>" },
    { "type": "richtext", "id": "acc_size", "label": "Akordeon - Size", "default": "<p>Oversized streetwear fit. True to size - size down for a regular fit. See the size guide for measurements.</p>" }
  ],
  "presets": [ { "name": "Produkt" } ]
}
{% endschema %}
