<div class="g-wrap" style="padding:48px 24px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;">
  <div>{% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 900 }}" style="width:100%;border:1px solid var(--line);border-radius:6px;display:block;">{% endif %}</div>
  <div>
    <h1 style="font-weight:800;font-size:clamp(24px,3vw,34px);letter-spacing:-0.02em;margin:0 0 10px;">{{ product.title }}</h1>
    <div style="font-weight:700;font-size:20px;margin-bottom:20px;">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s style="color:#999;font-weight:400;font-size:16px;">{{ product.compare_at_price | money }}</s>{% endif %}</div>
    {% form 'product', product %}
      {% unless product.has_only_default_variant %}
      <select name="id" style="width:100%;padding:12px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;margin-bottom:14px;background:#fff;">
        {% for variant in product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — vyprodáno{% endunless %}</option>{% endfor %}
      </select>
      {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
      <button type="submit" class="g-btn" style="width:100%;"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Přidat do košíku — {{ product.price | money }}{% else %}Vyprodáno{% endif %}</button>
    {% endform %}
    <div style="margin-top:24px;font-size:15px;line-height:1.6;">{{ product.description }}</div>
  </div>
</div>
<style>@media (max-width:760px){ .g-wrap[style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr !important;} }</style>
{% schema %}{ "name": "Produkt", "settings": [] }{% endschema %}