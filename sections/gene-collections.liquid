<section class="g-wrap" style="padding:56px 24px 8px;max-width:1720px;">
  <h2 class="g-h2" style="margin-bottom:24px;">{{ section.settings.title }}</h2>
  <div class="gcol-grid">
    {%- for block in section.blocks -%}
    {%- liquid
      assign c = block.settings.collection
      assign img = block.settings.image | default: c.featured_image
      assign label = block.settings.title | default: c.title
    -%}
    <a {{ block.shopify_attributes }} class="gcol-tile{% if forloop.first %} gcol-big{% endif %}" href="{{ c.url | default: '#' }}">
      {%- if img -%}<img src="{{ img | image_url: width: 900 }}" alt="{{ label | escape }}" loading="lazy">{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
      <div class="gcol-cap"><span style="{% if forloop.first %}font-size:26px;{% else %}font-size:18px;{% endif %}">{{ label }}</span></div>
    </a>
    {%- endfor -%}
  </div>
</section>
<style>
.gcol-grid { display:grid; grid-template-columns:2fr 1fr 1fr; grid-template-rows:auto auto; gap:16px; }
.gcol-tile { position:relative; min-height:284px; border:1px solid var(--line); border-radius:6px; overflow:hidden; display:block; }
.gcol-big { grid-row:span 2; min-height:584px; border:1.5px solid var(--ink); transition:transform .2s var(--ease); }
.gcol-big:hover { transform:translateY(-2px); }
.gcol-tile img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .4s var(--ease); }
.gcol-tile:hover img { transform:scale(1.05); }
.gcol-cap { position:absolute; left:0; bottom:0; right:0; padding:16px; background:linear-gradient(transparent,rgba(0,0,0,0.55)); }
.gcol-cap span { color:#fff; font-weight:800; letter-spacing:-0.01em; }
@media (max-width:900px){ .gcol-grid{ grid-template-columns:1fr; } .gcol-big{ grid-row:auto; min-height:320px; } }
</style>
{% schema %}
{
  "name": "GENE — Kategorie",
  "tag": "section",
  "max_blocks": 5,
  "settings": [ { "type": "text", "id": "title", "label": "Titulek", "default": "Shop by category" } ],
  "blocks": [
    { "type": "tile", "name": "Dlaždice", "settings": [
      { "type": "collection", "id": "collection", "label": "Kolekce" },
      { "type": "image_picker", "id": "image", "label": "Vlastní obrázek (jinak obrázek kolekce)" },
      { "type": "text", "id": "title", "label": "Vlastní název (jinak název kolekce)" }
    ] }
  ],
  "presets": [ { "name": "GENE — Kategorie", "blocks": [
    { "type": "tile", "settings": { "title": "New Arrivals" } },
    { "type": "tile", "settings": { "title": "Tees" } },
    { "type": "tile", "settings": { "title": "Hoodies" } },
    { "type": "tile", "settings": { "title": "Bottoms" } },
    { "type": "tile", "settings": { "title": "Shorts" } }
  ] } ]
}
{% endschema %}