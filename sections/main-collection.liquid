{%- paginate collection.products by section.settings.per_page -%}
<section class="gene-sec gene-wrap">
  <div class="gene-sechead"><div>
    <div class="gene-kicker">{{ collection.products_count }} products</div>
    <h2>{{ collection.title }}</h2>
  </div></div>
  {%- if collection.description != blank -%}<p style="color:var(--fg-2);max-width:640px;margin:-12px 0 24px">{{ collection.description }}</p>{%- endif -%}
  <div class="gene-grid">
    {%- for product in collection.products -%}
      {% render 'product-card', card_product: product %}
    {%- else -%}
      <p>No products found.</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <div style="display:flex;gap:10px;justify-content:center;margin-top:32px;font-family:var(--font-mono);font-size:13px">{{ paginate | default_pagination }}</div>
  {%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Collection","settings":[{"type":"range","id":"per_page","label":"Products per page","min":8,"max":24,"step":4,"default":16}]}
{% endschema %}