<div class="g-wrap" style="padding:48px 24px;">
  <h1 style="font-weight:800;font-size:clamp(28px,3.4vw,38px);letter-spacing:-0.02em;text-transform:uppercase;">{{ collection.title }}</h1>
  {% paginate collection.products by 24 %}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;">
    {% for product in collection.products %}
    <a href="{{ product.url }}" style="border:1px solid var(--line);border-radius:6px;overflow:hidden;text-decoration:none;background:var(--paper);display:block;">
      {% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 500 }}" style="width:100%;aspect-ratio:4/5;object-fit:cover;display:block;" loading="lazy">{% endif %}
      <div style="padding:12px;"><div style="font-weight:600;font-size:14px;">{{ product.title }}</div><div style="font-weight:700;margin-top:4px;">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s style="color:#999;font-weight:400;">{{ product.compare_at_price | money }}</s>{% endif %}</div></div>
    </a>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}<div style="margin-top:24px;text-align:center;">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</div>
{% schema %}{ "name": "Kolekce — mřížka", "settings": [] }{% endschema %}