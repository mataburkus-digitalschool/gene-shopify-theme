<div id="gcg-{{ section.id }}" class="g-wrap" style="padding:48px 24px;">
  <h1 style="font-weight:800;font-size:clamp(28px,3.4vw,38px);letter-spacing:-0.02em;text-transform:uppercase;margin:0 0 22px;">{{ collection.title }}</h1>
  {% paginate collection.products by 24 %}
  <div class="gcg-grid">
    {% for product in collection.products %}
      {%- liquid
        assign sold_out = false
        unless product.available
          assign sold_out = true
        endunless
      -%}
      <div class="gcg-card" data-product>
        {%- comment -%}
          Ikona košíku stojí vedle odkazu, ne v něm — tlačítko uvnitř <a> by
          se pořád chovalo jako proklik na produkt.
        {%- endcomment -%}
        <div class="gcg-mediawrap">
          <a href="{{ product.url }}" class="gcg-media">
            {% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
            {%- if sold_out -%}<span class="gcg-badge">Sold out</span>{%- elsif product.compare_at_price > product.price -%}<span class="gcg-badge gcg-badge--sale">Sale</span>{%- endif -%}
          </a>
          {%- unless sold_out -%}
            <button class="gcg-qa" type="button" data-qa-open aria-label="Přidat {{ product.title | escape }} do košíku">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 8.5h11v10a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5v-10Z"/><path d="M7.5 8.5V6.5a2.5 2.5 0 0 1 5 0v2"/><path d="M19 3.5v5M16.5 6h5"/></svg>
            </button>
          {%- endunless -%}
        </div>
        <div class="gcg-info">
          <a href="{{ product.url }}" class="gcg-name">{{ product.title }}</a>
          <div class="gcg-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
          {%- if sold_out -%}
            <button class="gcg-add gcg-add--out" type="button" disabled>Sold out</button>
          {%- else -%}
            <a class="gcg-add" href="{{ product.url }}">Preview</a>
            <script type="application/json" class="gg-qa">{"name":{{ product.title | json }},"price":{{ product.price | money | json }},"compare":{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},"img":{{ product.featured_media | image_url: width: 320 | json }},"url":{{ product.url | json }},"variants":[{%- for v in product.variants -%}{%- if product.has_only_default_variant -%}{%- assign vt = 'One size' -%}{%- else -%}{%- assign vt = v.title -%}{%- endif -%}{"id":{{ v.id }},"title":{{ vt | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
          {%- endif -%}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}<div style="margin-top:28px;text-align:center;">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</div>

<style>
  #gcg-{{ section.id }} .gcg-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  @media (max-width:640px){ #gcg-{{ section.id }} .gcg-grid { gap:10px; } }
  #gcg-{{ section.id }} .gcg-card { border:1px solid var(--line); border-radius:8px; overflow:hidden; background:var(--paper); display:flex; flex-direction:column; transition:border-color .2s var(--ease); }
  #gcg-{{ section.id }} .gcg-card:hover { border-color:var(--ink); }
  #gcg-{{ section.id }} .gcg-mediawrap { position:relative; }
  #gcg-{{ section.id }} .gcg-media { position:relative; display:block; aspect-ratio:1/1; background:#EFEFEF; overflow:hidden; }
  #gcg-{{ section.id }} .gcg-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #gcg-{{ section.id }} .gcg-badge { position:absolute; top:10px; left:10px; background:var(--paper); color:var(--ink); border:1px solid var(--ink); font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; padding:5px 11px; border-radius:999px; }
  #gcg-{{ section.id }} .gcg-badge--sale { background:var(--ink); color:#fff; border-color:var(--ink); }
  #gcg-{{ section.id }} .gcg-qa { position:absolute; right:10px; bottom:10px; z-index:2; width:40px; height:40px; padding:0; display:inline-flex; align-items:center; justify-content:center; border:none; border-radius:50%; background:rgba(227,226,222,.94); color:var(--ink); box-shadow:0 2px 10px rgba(0,0,0,.16); cursor:pointer; transition:transform .2s var(--ease), background .2s var(--ease); }
  #gcg-{{ section.id }} .gcg-qa svg { width:20px; height:20px; display:block; }
  #gcg-{{ section.id }} .gcg-qa:hover { transform:scale(1.08); background:#fff; }
  @media (max-width:640px){
    #gcg-{{ section.id }} .gcg-qa { width:34px; height:34px; right:7px; bottom:7px; }
    #gcg-{{ section.id }} .gcg-qa svg { width:17px; height:17px; }
  }
  #gcg-{{ section.id }} .gcg-info { padding:12px; display:flex; flex-direction:column; gap:8px; flex:1; }
  #gcg-{{ section.id }} .gcg-name { font-weight:600; font-size:14px; line-height:1.3; color:var(--ink); text-decoration:none; }
  #gcg-{{ section.id }} .gcg-price { font-weight:700; font-size:14px; }
  #gcg-{{ section.id }} .gcg-price s { color:var(--ink-muted); font-weight:400; margin-left:4px; }
  #gcg-{{ section.id }} .gcg-add { margin-top:auto; width:100%; box-sizing:border-box; text-align:center; text-decoration:none; background:var(--ink); color:#fff; border:none; border-radius:999px; padding:11px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; transition:opacity .15s var(--ease); }
  #gcg-{{ section.id }} .gcg-add:hover { opacity:.88; }
  #gcg-{{ section.id }} .gcg-add--out { background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); cursor:default; }
  #gcg-{{ section.id }} .gcg-add--out:hover { opacity:1; }
</style>
{% schema %}{ "name": "Kolekce — mřížka", "settings": [] }{% endschema %}
