<div id="gcg-{{ section.id }}" class="g-wrap" style="padding:48px 24px;">
  <h1 style="font-weight:800;font-size:clamp(28px,3.4vw,38px);letter-spacing:-0.02em;text-transform:uppercase;margin:0 0 22px;">{{ collection.title }}</h1>
  {% paginate collection.products by 24 %}
  <div class="gcg-grid">
    {% for product in collection.products %}
      {%- liquid
        assign sold_out = false
        unless product.available
          assign sold_out = true
        endunless
        assign cur = product.selected_or_first_available_variant
      -%}
      <div class="gcg-card">
        <a href="{{ product.url }}" class="gcg-media">
          {% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
          {%- if sold_out -%}<span class="gcg-badge">Sold out</span>{%- elsif product.compare_at_price > product.price -%}<span class="gcg-badge gcg-badge--sale">Sale</span>{%- endif -%}
          {%- comment -%} lupa napovídá, že se dá na produkt kliknout {%- endcomment -%}
          <span class="gcg-zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.8-3.8M11 8.4v5.2M8.4 11h5.2"/></svg>
          </span>
        </a>
        <div class="gcg-info">
          <a href="{{ product.url }}" class="gcg-name">{{ product.title }}</a>
          <div class="gcg-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
          {%- comment -%}
            Quick add otevírá výběr velikosti vždy, i u produktů s jedinou
            variantou — jinak se část karet chová jinak než zbytek. Produkt bez
            skutečných variant nabídne jednu položku „One size".
          {%- endcomment -%}
          {%- if sold_out -%}
            <button class="gcg-add gcg-add--out" type="button" disabled>Sold out</button>
          {%- else -%}
            <button class="gcg-add" type="button" data-qa-open>Quick add</button>
            <script type="application/json" class="gg-qa">{"name":{{ product.title | json }},"price":{{ product.price | money | json }},"img":{{ product.featured_media | image_url: width: 320 | json }},"variants":[{%- for v in product.variants -%}{%- if product.has_only_default_variant -%}{%- assign vt = 'One size' -%}{%- else -%}{%- assign vt = v.title -%}{%- endif -%}{"id":{{ v.id }},"title":{{ vt | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
          {%- endif -%}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}<div style="margin-top:28px;text-align:center;">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</div>

<div class="gg-modal" id="gcg-modal-{{ section.id }}" hidden>
  <div class="gg-modal__overlay" data-qa-close></div>
  <div class="gg-modal__panel" role="dialog" aria-modal="true" aria-label="Quick add">
    <div class="gg-modal__head">
      <span class="gg-modal__title">Quick add</span>
      <button class="gg-modal__close" type="button" data-qa-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="gg-modal__prod">
      <div class="gg-modal__img"><img data-qa-img src="" alt="" loading="lazy"></div>
      <div class="gg-modal__meta">
        <div class="gg-modal__name" data-qa-name></div>
        <div class="gg-modal__price" data-qa-price></div>
      </div>
    </div>
    <div class="gg-modal__label">Select size</div>
    <div class="gg-modal__sizes" data-qa-sizes></div>
  </div>
</div>

<style>
  #gcg-{{ section.id }} .gcg-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  @media (max-width:640px){ #gcg-{{ section.id }} .gcg-grid { gap:10px; } }
  #gcg-{{ section.id }} .gcg-card { border:1px solid var(--line); border-radius:8px; overflow:hidden; background:var(--paper); display:flex; flex-direction:column; transition:border-color .2s var(--ease); }
  #gcg-{{ section.id }} .gcg-card:hover { border-color:var(--ink); }
  #gcg-{{ section.id }} .gcg-media { position:relative; display:block; aspect-ratio:1/1; background:#EFEFEF; overflow:hidden; }
  #gcg-{{ section.id }} .gcg-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #gcg-{{ section.id }} .gcg-badge { position:absolute; top:10px; left:10px; background:var(--paper); color:var(--ink); border:1px solid var(--ink); font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; padding:5px 11px; border-radius:999px; }
  #gcg-{{ section.id }} .gcg-badge--sale { background:var(--ink); color:#fff; border-color:var(--ink); }
  #gcg-{{ section.id }} .gcg-zoom { position:absolute; right:10px; bottom:10px; z-index:2; pointer-events:none; width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(227,226,222,.92); color:var(--ink); box-shadow:0 2px 10px rgba(0,0,0,.14); transition:transform .2s var(--ease), background .2s var(--ease); }
  #gcg-{{ section.id }} .gcg-zoom svg { width:18px; height:18px; display:block; }
  #gcg-{{ section.id }} .gcg-card:hover .gcg-zoom { transform:scale(1.1); background:#fff; }
  @media (max-width:640px){
    #gcg-{{ section.id }} .gcg-zoom { width:28px; height:28px; right:7px; bottom:7px; }
    #gcg-{{ section.id }} .gcg-zoom svg { width:15px; height:15px; }
  }
  #gcg-{{ section.id }} .gcg-info { padding:12px; display:flex; flex-direction:column; gap:8px; flex:1; }
  #gcg-{{ section.id }} .gcg-name { font-weight:600; font-size:14px; line-height:1.3; color:var(--ink); text-decoration:none; }
  #gcg-{{ section.id }} .gcg-price { font-weight:700; font-size:14px; }
  #gcg-{{ section.id }} .gcg-price s { color:var(--ink-muted); font-weight:400; margin-left:4px; }
  #gcg-{{ section.id }} .gcg-add { margin-top:auto; width:100%; background:var(--ink); color:#fff; border:none; border-radius:999px; padding:11px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; transition:opacity .15s var(--ease); }
  #gcg-{{ section.id }} .gcg-add:hover { opacity:.88; }
  #gcg-{{ section.id }} .gcg-add--out { background:var(--paper); color:var(--ink); border:1.5px solid var(--ink); cursor:default; }
  #gcg-{{ section.id }} .gcg-add--out:hover { opacity:1; }

  /* quick-add size modal */
  #gcg-modal-{{ section.id }}.gg-modal { position:fixed; inset:0; z-index:300; display:flex; align-items:center; justify-content:center; }
  #gcg-modal-{{ section.id }}.gg-modal[hidden] { display:none; }
  #gcg-modal-{{ section.id }} .gg-modal__overlay { position:absolute; inset:0; background:rgba(0,0,0,0.5); }
  #gcg-modal-{{ section.id }} .gg-modal__panel { position:relative; z-index:1; width:460px; max-width:calc(100% - 32px); max-height:85vh; overflow-y:auto; background:var(--paper); border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,0.28); }
  #gcg-modal-{{ section.id }} .gg-modal__head { position:sticky; top:0; background:var(--paper); display:grid; grid-template-columns:24px 1fr 24px; align-items:center; padding:16px; border-bottom:1px solid var(--line); }
  #gcg-modal-{{ section.id }} .gg-modal__title { grid-column:2; text-align:center; font-weight:800; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; }
  #gcg-modal-{{ section.id }} .gg-modal__close { grid-column:3; background:none; border:none; padding:0; cursor:pointer; color:var(--ink); display:inline-flex; }
  #gcg-modal-{{ section.id }} .gg-modal__close svg { width:22px; height:22px; }
  #gcg-modal-{{ section.id }} .gg-modal__prod { display:flex; gap:14px; padding:16px; }
  #gcg-modal-{{ section.id }} .gg-modal__img { width:84px; height:100px; flex:none; border-radius:8px; overflow:hidden; background:#EFEFEF; }
  #gcg-modal-{{ section.id }} .gg-modal__img img { width:100%; height:100%; object-fit:cover; }
  #gcg-modal-{{ section.id }} .gg-modal__meta { display:flex; flex-direction:column; justify-content:center; gap:4px; }
  #gcg-modal-{{ section.id }} .gg-modal__name { font-weight:600; font-size:16px; }
  #gcg-modal-{{ section.id }} .gg-modal__price { font-weight:700; font-size:15px; }
  #gcg-modal-{{ section.id }} .gg-modal__label { padding:6px 16px 4px; font-weight:800; font-size:13px; letter-spacing:0.06em; text-transform:uppercase; }
  #gcg-modal-{{ section.id }} .gg-modal__sizes { display:flex; flex-direction:column; padding-bottom:8px; }
  #gcg-modal-{{ section.id }} .gg-msize { display:flex; align-items:center; justify-content:space-between; width:100%; padding:17px 16px; background:none; border:none; border-top:1px solid var(--line); font:inherit; font-weight:700; font-size:15px; text-align:left; color:var(--ink); cursor:pointer; }
  #gcg-modal-{{ section.id }} .gg-msize:hover:not(.is-out) { background:rgba(0,0,0,0.05); }
  #gcg-modal-{{ section.id }} .gg-msize.is-out { color:var(--ink-muted); cursor:default; }
  #gcg-modal-{{ section.id }} .gg-msize__oos { font-weight:700; font-size:14px; color:var(--ink-muted); }
  #gcg-modal-{{ section.id }} .gg-msize.is-loading { opacity:0.5; }
  @media (max-width:600px){
    #gcg-modal-{{ section.id }}.gg-modal { align-items:flex-end; }
    #gcg-modal-{{ section.id }} .gg-modal__panel { width:100%; max-width:100%; max-height:88vh; border-radius:18px 18px 0 0; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('gcg-{{ section.id }}');
  var modal = document.getElementById('gcg-modal-{{ section.id }}');
  if (!root || !modal || root.dataset.init) return;
  root.dataset.init = '1';
  var qaSizes = modal.querySelector('[data-qa-sizes]');

  function bumpCount() {
    fetch('{{ routes.cart_url }}.js').then(function (r) { return r.json(); }).then(function (c) {
      document.querySelectorAll('[data-cart-count]').forEach(function (el) {
        el.textContent = c.item_count;
        el.classList.remove('is-empty');
      });
    });
  }
  function add(id) {
    return fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: Number(id), quantity: 1 })
    }).then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); });
  }
  function openModal(card) {
    var dataEl = card.querySelector('.gg-qa');
    if (!dataEl) return;
    var d; try { d = JSON.parse(dataEl.textContent); } catch (e) { return; }
    var img = modal.querySelector('[data-qa-img]');
    if (img) { if (d.img) { img.src = d.img; img.style.display = ''; } else { img.style.display = 'none'; } }
    modal.querySelector('[data-qa-name]').textContent = d.name || '';
    modal.querySelector('[data-qa-price]').textContent = d.price || '';
    qaSizes.innerHTML = (d.variants || []).map(function (v) {
      if (v.available) {
        return '<button type="button" class="gg-msize" data-qa-size data-variant-id="' + v.id + '"><span>' + v.title + '</span></button>';
      }
      return '<div class="gg-msize is-out"><span>' + v.title + '</span><span class="gg-msize__oos">Out of stock</span></div>';
    }).join('');
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() { modal.hidden = true; document.body.style.overflow = ''; }

  root.addEventListener('click', function (e) {
    var openBtn = e.target.closest('[data-qa-open]');
    if (openBtn) { openModal(openBtn.closest('.gcg-card')); return; }
    var addBtn = e.target.closest('[data-add]');
    if (addBtn) {
      var id = addBtn.getAttribute('data-variant');
      if (!id) return;
      var orig = addBtn.textContent; addBtn.disabled = true; addBtn.textContent = '…';
      add(id).then(function () { bumpCount(); addBtn.textContent = '✓ Added'; setTimeout(function () { addBtn.textContent = orig; addBtn.disabled = false; }, 1500); })
             .catch(function () { addBtn.textContent = orig; addBtn.disabled = false; });
    }
  });
  modal.addEventListener('click', function (e) {
    if (e.target.closest('[data-qa-close]')) { closeModal(); return; }
    var sizeRow = e.target.closest('[data-qa-size]');
    if (!sizeRow || sizeRow.classList.contains('is-loading')) return;
    sizeRow.classList.add('is-loading');
    add(sizeRow.dataset.variantId).then(function () { bumpCount(); closeModal(); })
      .catch(function () { sizeRow.classList.remove('is-loading'); });
  });
  document.addEventListener('keydown', function (e) { if (!modal.hidden && e.key === 'Escape') closeModal(); });
})();
</script>
{% schema %}{ "name": "Kolekce — mřížka", "settings": [] }{% endschema %}
