{% render 'section-css', id: section.id, s: section.settings %}
<section id="gs-{{ section.id }}" class="gene-banner gene-bw" style="{% if section.settings.min_height != blank %}min-height:{{ section.settings.min_height }}px;{% endif %}">
  {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1800 }}" alt="">{% else %}<img src="https://genestreetwear.com/cdn/shop/files/f5f708459b933b03803f2129af040c35.jpg?width=1800" alt="">{% endif %}
  <div class="gene-banner__ov" style="background:rgba(26,26,26,{{ section.settings.overlay | default: 50 | divided_by: 100.0 }})"></div>
  <div class="gene-banner__c">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.cta_text != blank %}<a class="gene-btn gene-btn--light" href="{{ section.settings.cta_link | default: '#archive' }}"><span style="font-size:.7em">&bull;</span> {{ section.settings.cta_text }}</a>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (demo GENE photo shows if empty)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT DIFFERENT. WORN LOUD."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Height",
      "min": 240,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}