{% render 'section-css', id: section.id, s: section.settings %}
<section id="gs-{{ section.id }}" class="gene-sec gene-wrap" style="padding-bottom:24px">
  <div class="gene-news" style="{% if section.settings.card_bg != blank %}background:{{ section.settings.card_bg }};{% endif %}{% if section.settings.card_text != blank %}color:{{ section.settings.card_text }};{% endif %}">
    <div>
      {% if section.settings.kicker != blank %}<div class="gene-news__k">{{ section.settings.kicker }}</div>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div>
      {% form 'customer' %}
        {% if form.posted_successfully? %}
          <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:6px;padding:22px;text-align:center">
            <div style="font-family:var(--font-display);font-weight:700;font-size:18px;margin-bottom:6px">You're in.</div>
            <p style="font-size:13.5px;opacity:.7;margin:0">Use code <b style="font-family:var(--font-mono)">{{ section.settings.code }}</b> at checkout for {{ section.settings.discount }}.</p>
          </div>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="gene-news__form">
            <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
            <button type="submit">{{ section.settings.button }}</button>
          </div>
          <p class="gene-news__note">{{ section.settings.disclaimer }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the fam"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first drop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Early access to restocks and new drops before they sell out. No spam — just fire fits."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Get 10% off"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount code",
      "default": "FAM10"
    },
    {
      "type": "text",
      "id": "discount",
      "label": "Discount text",
      "default": "10% off"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "By signing up you agree to receive email marketing. Unsubscribe anytime."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}