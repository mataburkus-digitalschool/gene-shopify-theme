<section style="position:relative;margin:64px 0 0;min-height:440px;display:flex;align-items:center;justify-content:center;overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);">
  {%- if section.settings.image -%}
  <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
  {%- else -%}
  <div style="position:absolute;inset:0;background:repeating-linear-gradient(135deg,#2a2a2a 0 6px,#222 6px 12px);"></div>
  {%- endif -%}
  <div style="position:absolute;inset:0;background:rgba(26,26,26,0.5);"></div>
  <div style="position:relative;text-align:center;color:#fff;padding:24px;">
    <h2 style="font-weight:800;font-size:clamp(34px,5vw,60px);letter-spacing:-0.02em;margin:0 0 20px;line-height:1;">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_url }}" style="display:inline-flex;align-items:center;gap:9px;background:#fff;color:var(--ink);border-radius:999px;padding:14px 30px;font-weight:700;font-size:15px;text-decoration:none;"><span style="font-size:0.7em;">●</span> {{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "GENE — Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Obrázek pozadí" },
    { "type": "textarea", "id": "heading", "label": "Titulek", "default": "BUILT DIFFERENT.\nWORN LOUD." },
    { "type": "text", "id": "btn_label", "label": "Tlačítko — text", "default": "Shop the drop" },
    { "type": "url", "id": "btn_url", "label": "Tlačítko — odkaz" }
  ],
  "presets": [ { "name": "GENE — Banner" } ]
}
{% endschema %}