<header class="gene-header" id="gh-{{ section.id }}"{% unless section.settings.sticky %} style="position:relative"{% endunless %}>
  <div class="gene-wrap gene-header__in">
    <a href="{{ routes.root_url }}" class="gene-logo">{% if section.settings.logo %}<img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="height:{{ section.settings.logo_height | default: 32 }}px;width:auto">{% else %}{{ section.settings.brand_text }}{% endif %}</a>
    <nav class="gene-nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if forloop.first %} style="color:var(--aipa-ink);font-weight:700"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="gene-head-actions">
      {% if section.settings.show_login %}<a href="{{ routes.account_url }}" style="font-size:13px;font-weight:500;color:var(--fg-2)">{{ section.settings.login_text }}</a>{% endif %}
      <button class="gene-cartbtn" data-cart-toggle>{{ section.settings.cart_text }} <span data-cart-count>{{ cart.item_count }}</span></button>
    </div>
  </div>
</header>
{% style %}#gh-{{ section.id }}{ {% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.border_color != blank %}border-bottom-color:{{ section.settings.border_color }};{% endif %} }
{% if section.settings.link_color != blank %}#gh-{{ section.id }} .gene-nav a{color:{{ section.settings.link_color }}}{% endif %}
{% if section.settings.logo_color != blank %}#gh-{{ section.id }} .gene-logo{color:{{ section.settings.logo_color }}}{% endif %}{% endstyle %}
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text (if no logo)",
      "default": "GENE®"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Brand text color"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show login link",
      "default": true
    },
    {
      "type": "text",
      "id": "login_text",
      "label": "Login text",
      "default": "Log in"
    },
    {
      "type": "text",
      "id": "cart_text",
      "label": "Cart text",
      "default": "Cart"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Nav link color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border"
    }
  ]
}
{% endschema %}