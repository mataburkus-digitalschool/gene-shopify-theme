{% render 'section-css', id: section.id, s: section.settings %}
<section id="gs-{{ section.id }}" class="gene-hero gene-bw">
  <div class="gene-wrap gene-hero__grid">
    <div>
      {% if section.settings.eyebrow != blank %}<div class="gene-eyebrow"><i></i>{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="gene-hero__ctas">
        {% if section.settings.cta1_text != blank %}<a class="gene-btn gene-btn--ink" href="{{ section.settings.cta1_link | default: '#archive' }}"><span style="font-size:.7em">&bull;</span> {{ section.settings.cta1_text }}</a>{% endif %}
        {% if section.settings.cta2_text != blank %}<a class="gene-btn gene-btn--out" href="{{ section.settings.cta2_link | default: '#bundles' }}">{{ section.settings.cta2_text }}</a>{% endif %}
      </div>
      {% if section.settings.show_rating %}<div style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--fg-2)"><span class="gene-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <span><b style="color:var(--aipa-ink)">{{ section.settings.rating }}</b> {{ section.settings.rating_text }}</span></div>{% endif %}
    </div>
    <div class="gene-hero__media" style="{% if section.settings.image_ratio != blank %}aspect-ratio:{{ section.settings.image_ratio }};{% endif %}{% if section.settings.image_position == 'left' %}order:-1;{% endif %}">
      {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}">{% else %}<img src="https://genestreetwear.com/cdn/shop/files/714E1C8A-3838-4CCD-B686-68150E2E3A8A_40cf126a-4656-4adc-9d57-3a106dfc02fe.png?width=1200" alt="{{ section.settings.heading | escape }}">{% endif %}
      {% if section.settings.tag != blank %}<div class="gene-hero__tag">{{ section.settings.tag }}</div>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT DIFFERENT. WORN LOUD."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited streetwear drops built to stand out. Once a piece sells out, it's gone for good. Join 8,900+ already wearing GENE."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited drop · No restock"
    },
    {
      "type": "text",
      "id": "cta1_text",
      "label": "CTA 1 text",
      "default": "Shop Summer Archive"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "CTA 1 link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "CTA 2 text",
      "default": "Shop Bundles"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "CTA 2 link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "from 8,900+ verified customers"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (demo GENE photo shows if empty)"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Image tag",
      "default": "SS ARCHIVE ’26 · UP TO 35% OFF"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "image_ratio",
      "label": "Image ratio (e.g. 4/4.4)",
      "default": "4/4.4"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "h1_size",
      "label": "Headline size",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}